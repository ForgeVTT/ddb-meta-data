.2254248593736,1180.57295199801,3762.7745751406264,1180.57295199801],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"zEFF6mRFC49jnfeQ"},{"c":[3762.7745751406264,1180.57295199801,3750.2745751406264,1189.6547335980772],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"ZByXLYQiT5b39nvf"},{"c":[3750.2745751406264,1219.0439962127007,3762.7745751406264,1228.1257778127679],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"ucc7EToCcX3sl7Fs"},{"c":[3778.2254248593736,1228.1257778127679,3790.7254248593736,1219.0439962127007],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"HcQZ6bju9tZnt6g8"},{"c":[3762.7745751406264,1228.1257778127679,3778.2254248593736,1228.1257778127679],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"7OhTN5ygdN1JVrYb"},{"c":[3745.5,1204.349364905389,3750.2745751406264,1219.0439962127007],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"8HEHgPd19t4GZewx"},{"c":[3790.7254248593736,1219.0439962127007,3795.5,1204.349364905389],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"i6pHOP1E45QKDuUz"},{"c":[3750.2745751406264,1189.6547335980772,3745.5,1204.349364905389],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"3AHmUpx5OBwjc5hI"},{"c":[3882.5,1216.349364905389,3870,1194.6987298107779],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"0IFdy6IvtbQ0CXxU"},{"c":[3870,1194.6987298107779,3845,1194.6987298107779],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"POkAb80OCpCwftnh"},{"c":[3845,1194.6987298107779,3832.5,1216.349364905389],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"1efLunJhKuzM0lOo"},{"c":[3832.5,1216.349364905389,3845,1238],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"Z0klKiGC0i2tzoAM"},{"c":[3845,1238,3870,1238],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"QdG7ira0XrNk0mOr"},{"c":[3870,1238,3882.5,1216.349364905389],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"kndvWUtCHjYglpFj"},{"c":[3400,2300,3400,2400],"light":20,"move":20,"sight":20,"sound":20,"dir":0,"door":1,"ds":0,"flags":{},"_id":"I9plBEUlbtmmWkIL"},{"c":[1982,2500.5,1976.0795268256234,2478.458053039032],"light":20,"move":0,"sight":20,"sound":0,"dir":0,"door":0,"ds":0,"flags":{},"_id":"SqmIbJa9GsC2SKzS"},{"c":[1925.9204731743766,2478.458053039032,1920,2500.5],"light":20,"move":0,"sight":20,"sound":0,"dir":0,"door":0,"ds":0,"flags":{},"_id":"cBjGe9DiFHbb5FUp"},{"c":[1920,2500.5,1925.9204731743766,2522.541946960968],"light":20,"move":0,"sight":20,"sound":0,"dir":0,"door":0,"ds":0,"flags":{},"_id":"dH5qTlud78ngVLdD"},{"c":[1976.0795268256234,2522.541946960968,1982,2500.5],"light":20,"move":0,"sight":20,"sound":0,"dir":0,"door":0,"ds":0,"flags":{},"_id":"HyRtZScFpMWtZ8Sa"}],"weather":"","width":4185,"img":"ddb://image/slw/unnbj-map-wayside-inn_player.jpg","tokens":[{"_id":"pFANwtxRPxvIuwW6","name":"Cooragh Struckt","width":1,"height":1,"scale":1,"x":1900,"y":2600,"disposition":1,"flags":{"ddbActorFlags":{"id":16829,"entityTypeId":779871897,"creatureGroup":null,"creatureFlags":[],"flatAC":true,"version":"2.8.20","name":"Commoner"}},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"elevation":0,"hidden":false,"tint":null,"actorData":{"data":{"details":{"type":{"subtype":"Half-Orc"},"cr":"0","biography":{"value":"<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"606f484c-681e-4555-aec3-3f5a315d471e\">Cooragh only emerges from the kitchen long enough to thank the adventurers and give them a piece of her special pork pie.\n<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"606f484c-681e-4555-aec3-3f5a315d471e\">It is very spicy, but delicious for those who can stomach the burn.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"606f484c-681e-4555-aec3-3f5a315d471e\">On her neck, beneath each ear, are tattoos of curved daggers.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"606f484c-681e-4555-aec3-3f5a315d471e\">If asked, she admits she got them because she knew it would upset her mother, a human from Luskan.\n<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"606f484c-681e-4555-aec3-3f5a315d471e\">It was a foolish youthful folly, she says.</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>"}},"resources":{"lair":{"value":false}}},"oldHpVal":4},"light":{"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}}},{"_id":"HL9v743V7WKQuOLF","name":"Zombie","width":1,"height":1,"scale":1,"x":1500,"y":1200,"disposition":-1,"flags":{"ddbActorFlags":{"id":17077,"entityTypeId":779871897,"creatureGroup":null,"creatureFlags":[],"flatAC":true,"version":"2.8.20","name":"Zombie"}},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"elevation":0,"hidden":false,"tint":null,"actorData":{"data":{"resources":{"lair":{"value":false}}},"oldHpVal":22},"light":{"alpha":0.5,"angle":360,"bright":0,"coloration":1,"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}}},{"_id":"cj1ZuGihRtxRRUPU","name":"Wraith","width":1,"height":1,"scale":1,"x":2400,"y":1200,"disposition":-1,"flags":{"ddbActorFlags":{"id":17064,"entityTypeId":779871897,"creatureGroup":null,"creatureFlags":[],"flatAC":true,"version":"2.8.20","name":"Wraith"}},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"elevation":0,"hidden":false,"tint":null,"actorData":{"data":{"resources":{"lair":{"value":false}}},"oldHpVal":67},"light":{"alpha":0.5,"angle":360,"bright":0,"coloration":1,"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}}},{"_id":"2SP3sk0pNCZ2b44f","name":"Martisha Vinetalker","width":1,"height":1,"scale":1,"x":1500,"y":1900,"disposition":0,"flags":{"ddbActorFlags":{"id":16829,"entityTypeId":779871897,"creatureGroup":null,"creatureFlags":[],"flatAC":true,"version":"2.8.20","name":"Commoner"}},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"elevation":0,"hidden":false,"tint":null,"actorData":{"data":{"details":{"cr":"0","biography":{"value":"<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"129595e3-8b37-4ba9-9b3c-917263dec77c\">Martisha sits in the corner at a lone table, poring over records and watching the business. She answers any attempts at conversation curtly.\n<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"129595e3-8b37-4ba9-9b3c-917263dec77c\">She wants to partner with the settlers of Leilon to set up a mutual protection pact, as well as a trade pact where she sells her vegetables and livestock in return for the goods they will produce.</li>\n</ul>\n</li>\n</ul>"}},"resources":{"lair":{"value":false}}},"oldHpVal":4},"light":{"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}}},{"_id":"uTQF5FZ1ryNuSsKo","name":"Bales","width":1,"height":1,"scale":1,"x":1700,"y":2400,"disposition":1,"flags":{"ddbActorFlags":{"id":16829,"entityTypeId":779871897,"creatureGroup":null,"creatureFlags":[],"flatAC":true,"version":"2.8.20","name":"Commoner"}},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"elevation":0,"hidden":false,"tint":null,"actorData":{"name":"Commoner","data":{"details":{"cr":"0","biography":{"value":"<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"407d9b2c-5659-4dbe-9b38-c5a83593d47b\">Backes keeps the ale flowing all night for the adventurers.\n<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"407d9b2c-5659-4dbe-9b38-c5a83593d47b\">He tells them that he gave up a life as a privateer (that is, a pirate) to get into business on land.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"407d9b2c-5659-4dbe-9b38-c5a83593d47b\">He works the bar and assists Martisha, but he hopes to someday open his own place in Neverwinter or Waterdeep.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"407d9b2c-5659-4dbe-9b38-c5a83593d47b\">He wears a pendant around his neck in the shape of a trident, which he says the crew of his last ship wore as a way to appease the many sea gods.</li>\n</ul>\n</li>\n</ul>"}},"resources":{"lair":{"value":false}}},"oldHpVal":4},"light":{"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}}},{"_id":"eP4SaDHuSFT7OWAM","name":"Teega","width":1,"height":1,"scale":1,"x":2000,"y":2100,"disposition":1,"flags":{"ddbActorFlags":{"id":16829,"entityTypeId":779871897,"creatureGroup":null,"creatureFlags":[],"flatAC":true,"version":"2.8.20","name":"Commoner"}},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"elevation":0,"hidden":false,"tint":null,"actorData":{"data":{"details":{"cr":"0","biography":{"value":"<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"36c02100-467e-4489-a752-0ecdf8a5b6db\">The smith who works at the Wayside Inn smithy is a strapping woman called Teega who can wield a hammer in each hand like a titan.\n<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"36c02100-467e-4489-a752-0ecdf8a5b6db\">Her anvil is forged in the shape of a dolphin, and at night she drinks at the bar with the other patrons.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"36c02100-467e-4489-a752-0ecdf8a5b6db\">She met Backes after his life as a pirate ended, and she hopes to join him in setting up a business in a city at some point.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"36c02100-467e-4489-a752-0ecdf8a5b6db\">She makes jewelry in her spare time and wears a set of bronze bracers shaped like three lightning bolts.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"36c02100-467e-4489-a752-0ecdf8a5b6db\">She proudly displays three suits of plate armor that she created, each bearing the same symbol as the design of her bracers.</li>\n</ul>\n</li>\n</ul>"}},"resources":{"lair":{"value":false}}},"oldHpVal":4},"light":{"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}}},{"_id":"HoOVzqgTpGrOsudQ","name":"Silla Scalesweep","width":1,"height":1,"scale":1,"x":2000,"y":1600,"disposition":1,"flags":{"ddbActorFlags":{"id":16829,"entityTypeId":779871897,"creatureGroup":null,"creatureFlags":[],"flatAC":true,"version":"2.8.20","name":"Commoner"}},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"elevation":0,"hidden":false,"tint":null,"actorData":{"data":{"details":{"type":{"subtype":"Halfling"},"cr":"0","biography":{"value":"<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"c66eb73d-38a1-46ed-8cf3-c8ea73c68b7d\">A young halfling named Silla Scalesweep sits at a table, humming to herself.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"c66eb73d-38a1-46ed-8cf3-c8ea73c68b7d\">She is traveling from Neverwinter to Leilon, hoping to get hired on as a fisher by Valdi Estapaar, the woman in charge of the fishery in the town.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"c66eb73d-38a1-46ed-8cf3-c8ea73c68b7d\">She wears her long hair in five braids atop her head, and she is very talkative.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"c66eb73d-38a1-46ed-8cf3-c8ea73c68b7d\">She also plays the harmonica quite well and is keen to have an audience.</li>\n</ul>"}},"resources":{"lair":{"value":false}}},"oldHpVal":4},"light":{"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}}},{"_id":"KTzx0lQv4KFAtQyX","name":"Tarbin Tul","width":1,"height":1,"scale":1,"x":2000,"y":1400,"disposition":1,"flags":{"ddbActorFlags":{"id":16829,"entityTypeId":779871897,"creatureGroup":null,"creatureFlags":[],"flatAC":true,"version":"2.8.20","name":"Commoner"}},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"elevation":0,"hidden":false,"tint":null,"actorData":{"data":{"details":{"type":{"subtype":"Tarbin Tul"},"cr":"0","biography":{"value":"<p><span style=\"color: #191813;\">Tarbin Tul</span></p>\n<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"4a53aa19-ebfe-48b4-9653-eb67251234c2\">Tarbin Tul is a traveling bard who wanders the High Road, seeking new songs to add to his already impressive repertoire.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"4a53aa19-ebfe-48b4-9653-eb67251234c2\">Tarbin sits by the fire, singing along to Silla&rsquo;s ditties on the harmonica.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"4a53aa19-ebfe-48b4-9653-eb67251234c2\">He gladly buys a drink for anyone who helped drive off the undead.</li>\n</ul>"}},"resources":{"lair":{"value":false}}},"oldHpVal":4},"light":{"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}}},{"_id":"sngelRJbSpnWR72W","name":"Barmaid","width":1,"height":1,"scale":1,"x":1600,"y":2300,"disposition":1,"flags":{"ddbAc