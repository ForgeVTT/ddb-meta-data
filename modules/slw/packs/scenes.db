":{},"_id":"VKP3ZFZBGp0wM2J7"},{"c":[2049.5,1190.349364905389,2037,1212],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"D1zJdOkbhOpeFb1y"},{"c":[2037,1212,2049.5,1233.650635094611],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"E7JzAEzy7xdowxue"},{"c":[2049.5,1233.650635094611,2074.5,1233.650635094611],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"aLjWiyXi5xSPLHG0"},{"c":[2074.5,1233.650635094611,2087,1212],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"lnUa76tiLaqgvIpm"},{"c":[3795.5,1204.349364905389,3790.7254248593736,1189.6547335980772],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"k0dDLTkTus5hW97d"},{"c":[3790.7254248593736,1189.6547335980772,3778.2254248593736,1180.57295199801],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"SUGVUeizA83iPOTN"},{"c":[3778.2254248593736,1180.57295199801,3762.7745751406264,1180.57295199801],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"ver6BGZBbhdb9Im7"},{"c":[3762.7745751406264,1180.57295199801,3750.2745751406264,1189.6547335980772],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"Y2Wk9VqiH6mVIDkC"},{"c":[3750.2745751406264,1219.0439962127007,3762.7745751406264,1228.1257778127679],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"rdi7EP1RebkOBPAs"},{"c":[3778.2254248593736,1228.1257778127679,3790.7254248593736,1219.0439962127007],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"pTrZJnUug3BUFsJO"},{"c":[3762.7745751406264,1228.1257778127679,3778.2254248593736,1228.1257778127679],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"msqn7XKj5tBghUVo"},{"c":[3745.5,1204.349364905389,3750.2745751406264,1219.0439962127007],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"1QueYpcuOMFygs0a"},{"c":[3790.7254248593736,1219.0439962127007,3795.5,1204.349364905389],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"7i7wsFtiBLHDDTL7"},{"c":[3750.2745751406264,1189.6547335980772,3745.5,1204.349364905389],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"1gXS3uNJT8q05OEi"},{"c":[3882.5,1216.349364905389,3870,1194.6987298107779],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"b9DXV5hnuBovn46E"},{"c":[3870,1194.6987298107779,3845,1194.6987298107779],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"aze0ufvhFRXyhQeL"},{"c":[3845,1194.6987298107779,3832.5,1216.349364905389],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"iv973mul8MVsoWjQ"},{"c":[3832.5,1216.349364905389,3845,1238],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"VN3cmLdDJHj0lZiU"},{"c":[3845,1238,3870,1238],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"b1ufDyWpe5jAT5ES"},{"c":[3870,1238,3882.5,1216.349364905389],"light":10,"move":20,"sight":10,"sound":10,"dir":0,"door":0,"ds":0,"flags":{},"_id":"fa2vqFZ5FhnsdSRF"},{"c":[3400,2300,3400,2400],"light":20,"move":20,"sight":20,"sound":20,"dir":0,"door":1,"ds":0,"flags":{},"_id":"bHk2GKLdADHWU6AM"},{"c":[1982,2500.5,1976.0795268256234,2478.458053039032],"light":20,"move":0,"sight":20,"sound":0,"dir":0,"door":0,"ds":0,"flags":{},"_id":"j3IlMQt6sG9BZ6OD"},{"c":[1925.9204731743766,2478.458053039032,1920,2500.5],"light":20,"move":0,"sight":20,"sound":0,"dir":0,"door":0,"ds":0,"flags":{},"_id":"lRdzs4QiAs0gcu2A"},{"c":[1920,2500.5,1925.9204731743766,2522.541946960968],"light":20,"move":0,"sight":20,"sound":0,"dir":0,"door":0,"ds":0,"flags":{},"_id":"w4jW9PKCwMQ2sJJN"},{"c":[1976.0795268256234,2522.541946960968,1982,2500.5],"light":20,"move":0,"sight":20,"sound":0,"dir":0,"door":0,"ds":0,"flags":{},"_id":"YshJWZOv3sb9Bs1d"}],"weather":"raintop","width":4185,"img":"ddb://image/slw/unnbj-map-wayside-inn_player.jpg","tokens":[{"_id":"PYmkDzFBVPF9oJmn","name":"Martisha Vinetalker","width":1,"height":1,"scale":1,"x":5000,"y":2300,"disposition":0,"flags":{"ddbActorFlags":{"id":16829,"entityTypeId":779871897,"creatureGroup":null,"creatureFlags":[],"flatAC":true,"version":"2.8.20","name":"Commoner"}},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"elevation":0,"hidden":false,"tint":null,"actorData":{"data":{"details":{"cr":"0","biography":{"value":"<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"129595e3-8b37-4ba9-9b3c-917263dec77c\">Martisha sits in the corner at a lone table, poring over records and watching the business. She answers any attempts at conversation curtly.\n<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"129595e3-8b37-4ba9-9b3c-917263dec77c\">She wants to partner with the settlers of Leilon to set up a mutual protection pact, as well as a trade pact where she sells her vegetables and livestock in return for the goods they will produce.</li>\n</ul>\n</li>\n</ul>"}},"resources":{"lair":{"value":false}}},"oldHpVal":4},"light":{"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}}},{"_id":"EULNn9a4pp3zalhZ","name":"Barmaid","width":1,"height":1,"scale":1,"x":1400,"y":1100,"disposition":1,"flags":{"ddbActorFlags":{"id":16829,"entityTypeId":779871897,"creatureGroup":null,"creatureFlags":[],"flatAC":true,"version":"2.8.20","name":"Commoner"}},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"elevation":0,"hidden":false,"tint":null,"actorData":{"data":{"details":{"cr":"0"},"resources":{"lair":{"value":false}},"attributes":{"hp":{"value":1}}},"oldHpVal":4},"light":{"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}}},{"_id":"D9cqF682B0Ls6biy","name":"Bales","width":1,"height":1,"scale":1,"x":2300,"y":1200,"disposition":1,"flags":{"ddbActorFlags":{"id":16829,"entityTypeId":779871897,"creatureGroup":null,"creatureFlags":[],"flatAC":true,"version":"2.8.20","name":"Commoner"}},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"elevation":0,"hidden":false,"tint":null,"actorData":{"name":"Commoner","data":{"details":{"cr":"0","biography":{"value":"<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"407d9b2c-5659-4dbe-9b38-c5a83593d47b\">Backes keeps the ale flowing all night for the adventurers.\n<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"407d9b2c-5659-4dbe-9b38-c5a83593d47b\">He tells them that he gave up a life as a privateer (that is, a pirate) to get into business on land.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"407d9b2c-5659-4dbe-9b38-c5a83593d47b\">He works the bar and assists Martisha, but he hopes to someday open his own place in Neverwinter or Waterdeep.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"407d9b2c-5659-4dbe-9b38-c5a83593d47b\">He wears a pendant around his neck in the shape of a trident, which he says the crew of his last ship wore as a way to appease the many sea gods.</li>\n</ul>\n</li>\n</ul>"}},"resources":{"lair":{"value":false}},"attributes":{"hp":{"value":1}}},"oldHpVal":4},"light":{"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}}},{"_id":"jagE4m5ocOa2fL2P","name":"Cooragh Struckt","width":1,"height":1,"scale":1,"x":1300,"y":1200,"disposition":1,"flags":{"ddbActorFlags":{"id":16829,"entityTypeId":779871897,"creatureGroup":null,"creatureFlags":[],"flatAC":true,"version":"2.8.20","name":"Commoner"}},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"elevation":0,"hidden":false,"tint":null,"actorData":{"data":{"details":{"type":{"subtype":"Half-Orc"},"cr":"0","biography":{"value":"<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"606f484c-681e-4555-aec3-3f5a315d471e\">Cooragh only emerges from the kitchen long enough to thank the adventurers and give them a piece of her special pork pie.\n<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"606f484c-681e-4555-aec3-3f5a315d471e\">It is very spicy, but delicious for those who can stomach the burn.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"606f484c-681e-4555-aec3-3f5a315d471e\">On her neck, beneath each ear, are tattoos of curved daggers.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"606f484c-681e-4555-aec3-3f5a315d471e\">If asked, she admits she got them because she knew it would upset her mother, a human from Luskan.\n<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"606f484c-681e-4555-aec3-3f5a315d471e\">It was a foolish youthful folly, she says.</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>"}},"resources":{"lair":{"value":false}},"attributes":{"hp":{"value":1}}},"oldHpVal":4},"light":{"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}}},{"_id":"LmPaj4g8uTzJlHqV","name":"Silla Scalesweep","width":1,"height":1,"scale":1,"x":2400,"y":1200,"disposition":1,"flags":{"ddbActorFlags":{"id":16829,"entityTypeId":779871897,"creatureGroup":null,"creatureFlags":[],"flatAC":true,"version":"2.8.20","name":"Commoner"}},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"elevation":0,"hidden":false,"tint":null,"actorData":{"data":{"details":{"type":{"subtype":"Halfling"},"cr":"0","biography":{"value":"<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"c66eb73d-38a1-46ed-8cf3-c8ea73c68b7d\">A young halfling named Silla Scalesweep sits at a table, humming to herself.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"c66eb73d-38a1-46ed-8cf3-c8ea73c68b7d\">She is traveling from Neverwinter to Leilon, hoping to get hired on as a fisher by Valdi Estapaar, the woman in charge of the fishery in the town.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"c66eb73d-38a1-46ed-8cf3-c8ea73c68b7d\">She wears her long hair in five braids atop her head, and she is very talkative.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"c66eb73d-38a1-46ed-8cf3-c8ea73c68b7d\">She also plays the harmonica quite well and is keen to have an audience.</li>\n</ul>"}},"resources":{"lair":{"value":false}},"attributes":{"hp":{"value":1}}},"oldHpVal":4},"light":{"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}}},{"_id":"kB4oW3o8QAQ3om56","name":"Pig","width":1,"height":1,"scale":1,"x":2500,"y":2200,"disposition":-1,"flags":{"ddbActorFlags":{"id":299623,"entityTypeId":779871897,"creatureGroup":null,"creatureFlags":[],"flatAC":true,"version":"2.8.20","name":"Pig"}},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"elevation":0,"hidden":false,"tint":null,"actorData":{},"light":{"alpha":0.5,"angle":360,"bright":0,"coloration":1,"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}}},{"_id":"7L5XrGrBNcv9veH6","name":"Goat","width":1,"height":1,"scale":1,"x":2500,"y":2000,"disposition":-1,"flags":{"ddbActorFlags":{"id":16906,"entityTypeId":779871897,"creatureGroup":null,"creatureFlags":[],"flatAC":true,"version":"2.8.20","name":"Goat"}},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"elevation":0,"hidden":false,"tint":null,"actorData":{},"light":{"alpha":0.5,"angle":360,"bright":0,"coloration":1,"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}}},{"_id":"a8SRnb1ecqodtt77","name":"Riding Horse","width":2,"height":2,"scale":1,"x":2600,"y":1700,"disposition":-1,"flags":{"ddbActorFlags":{"id":16997,"entityTypeId":779871897,"creatureGroup":null,"creatureFlags":[],"flatAC":true,"version":"2.8.20",