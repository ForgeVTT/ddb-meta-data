0.65},"dim":10,"gradual":true,"luminosity":0.5,"saturation":0,"shadows":0},"flags":{},"hidden":false,"rotation":0,"vision":false,"walls":true,"x":4349.779891304348,"y":1252.414741847826},{"_id":"cjLqShZf0Xg7Xt9w","config":{"alpha":0.5,"angle":360,"animation":{"intensity":5,"reverse":false,"speed":5},"bright":10.45,"color":null,"coloration":1,"contrast":0,"darkness":{"max":1,"min":0},"dim":20.91,"gradual":true,"luminosity":0.5,"saturation":0,"shadows":0},"flags":{},"hidden":true,"rotation":0,"vision":false,"walls":true,"x":4549.779891304348,"y":3152.414741847826}],"name":"Map 5: Wayside Inn","navName":"Wayside Inn","notes":[],"padding":0.25,"shiftX":42,"shiftY":28,"tiles":[],"tokenVision":true,"tokens":[{"_id":"cA37f3jidM6NFqyB","actorData":{"data":{"details":{"biography":{"value":"<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"129595e3-8b37-4ba9-9b3c-917263dec77c\">Martisha sits in the corner at a lone table, poring over records and watching the business. She answers any attempts at conversation curtly.\n<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"129595e3-8b37-4ba9-9b3c-917263dec77c\">She wants to partner with the settlers of Leilon to set up a mutual protection pact, as well as a trade pact where she sells her vegetables and livestock in return for the goods they will produce.</li>\n</ul>\n</li>\n</ul>"},"cr":"0"},"resources":{"lair":{"value":false}}},"oldHpVal":4},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"disposition":0,"elevation":0,"flags":{"ddbActorFlags":{"creatureFlags":[],"creatureGroup":null,"entityTypeId":779871897,"flatAC":true,"id":16829,"name":"Commoner","version":"2.8.20"}},"height":1,"hidden":false,"light":{"alpha":0.5,"angle":360,"animation":{"intensity":5,"reverse":false,"speed":5},"bright":0,"color":null,"coloration":1,"contrast":0,"darkness":{"max":1,"min":0},"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"shadows":0},"name":"Martisha Vinetalker","scale":1,"tint":null,"width":1,"x":5000,"y":2300},{"_id":"b2Oo8Ef0LoWkHPcR","actorData":{"data":{"attributes":{"hp":{"value":1}},"details":{"cr":"0"},"resources":{"lair":{"value":false}}},"oldHpVal":4},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"disposition":1,"elevation":0,"flags":{"ddbActorFlags":{"creatureFlags":[],"creatureGroup":null,"entityTypeId":779871897,"flatAC":true,"id":16829,"name":"Commoner","version":"2.8.20"}},"height":1,"hidden":false,"light":{"alpha":0.5,"angle":360,"animation":{"intensity":5,"reverse":false,"speed":5},"bright":0,"color":null,"coloration":1,"contrast":0,"darkness":{"max":1,"min":0},"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"shadows":0},"name":"Barmaid","scale":1,"tint":null,"width":1,"x":1400,"y":1100},{"_id":"3AfEHPjYfzoTfU9g","actorData":{"data":{"attributes":{"hp":{"value":1}},"details":{"biography":{"value":"<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"407d9b2c-5659-4dbe-9b38-c5a83593d47b\">Backes keeps the ale flowing all night for the adventurers.\n<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"407d9b2c-5659-4dbe-9b38-c5a83593d47b\">He tells them that he gave up a life as a privateer (that is, a pirate) to get into business on land.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"407d9b2c-5659-4dbe-9b38-c5a83593d47b\">He works the bar and assists Martisha, but he hopes to someday open his own place in Neverwinter or Waterdeep.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"407d9b2c-5659-4dbe-9b38-c5a83593d47b\">He wears a pendant around his neck in the shape of a trident, which he says the crew of his last ship wore as a way to appease the many sea gods.</li>\n</ul>\n</li>\n</ul>"},"cr":"0"},"resources":{"lair":{"value":false}}},"name":"Commoner","oldHpVal":4},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"disposition":1,"elevation":0,"flags":{"ddbActorFlags":{"creatureFlags":[],"creatureGroup":null,"entityTypeId":779871897,"flatAC":true,"id":16829,"name":"Commoner","version":"2.8.20"}},"height":1,"hidden":false,"light":{"alpha":0.5,"angle":360,"animation":{"intensity":5,"reverse":false,"speed":5},"bright":0,"color":null,"coloration":1,"contrast":0,"darkness":{"max":1,"min":0},"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"shadows":0},"name":"Bales","scale":1,"tint":null,"width":1,"x":2300,"y":1200},{"_id":"rP0KCfoFYZIoOAAA","actorData":{"data":{"attributes":{"hp":{"value":1}},"details":{"biography":{"value":"<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"606f484c-681e-4555-aec3-3f5a315d471e\">Cooragh only emerges from the kitchen long enough to thank the adventurers and give them a piece of her special pork pie.\n<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"606f484c-681e-4555-aec3-3f5a315d471e\">It is very spicy, but delicious for those who can stomach the burn.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"606f484c-681e-4555-aec3-3f5a315d471e\">On her neck, beneath each ear, are tattoos of curved daggers.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"606f484c-681e-4555-aec3-3f5a315d471e\">If asked, she admits she got them because she knew it would upset her mother, a human from Luskan.\n<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"606f484c-681e-4555-aec3-3f5a315d471e\">It was a foolish youthful folly, she says.</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>"},"cr":"0","type":{"subtype":"Half-Orc"}},"resources":{"lair":{"value":false}}},"oldHpVal":4},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"disposition":1,"elevation":0,"flags":{"ddbActorFlags":{"creatureFlags":[],"creatureGroup":null,"entityTypeId":779871897,"flatAC":true,"id":16829,"name":"Commoner","version":"2.8.20"}},"height":1,"hidden":false,"light":{"alpha":0.5,"angle":360,"animation":{"intensity":5,"reverse":false,"speed":5},"bright":0,"color":null,"coloration":1,"contrast":0,"darkness":{"max":1,"min":0},"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"shadows":0},"name":"Cooragh Struckt","scale":1,"tint":null,"width":1,"x":1300,"y":1200},{"_id":"C4qk2PwBt4ZkSuXU","actorData":{"data":{"attributes":{"hp":{"value":1}},"details":{"biography":{"value":"<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"c66eb73d-38a1-46ed-8cf3-c8ea73c68b7d\">A young halfling named Silla Scalesweep sits at a table, humming to herself.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"c66eb73d-38a1-46ed-8cf3-c8ea73c68b7d\">She is traveling from Neverwinter to Leilon, hoping to get hired on as a fisher by Valdi Estapaar, the woman in charge of the fishery in the town.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"c66eb73d-38a1-46ed-8cf3-c8ea73c68b7d\">She wears her long hair in five braids atop her head, and she is very talkative.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"c66eb73d-38a1-46ed-8cf3-c8ea73c68b7d\">She also plays the harmonica quite well and is keen to have an audience.</li>\n</ul>"},"cr":"0","type":{"subtype":"Halfling"}},"resources":{"lair":{"value":false}}},"oldHpVal":4},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"disposition":1,"elevation":0,"flags":{"ddbActorFlags":{"creatureFlags":[],"creatureGroup":null,"entityTypeId":779871897,"flatAC":true,"id":16829,"name":"Commoner","version":"2.8.20"}},"height":1,"hidden":false,"light":{"alpha":0.5,"angle":360,"animation":{"intensity":5,"reverse":false,"speed":5},"bright":0,"color":null,"coloration":1,"contrast":0,"darkness":{"max":1,"min":0},"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"shadows":0},"name":"Silla Scalesweep","scale":1,"tint":null,"width":1,"x":2400,"y":1200},{"_id":"c0Lc9G1ojGGkpYDD","actorData":{},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"disposition":-1,"elevation":0,"flags":{"ddbActorFlags":{"creatureFlags":[],"creatureGroup":null,"entityTypeId":779871897,"flatAC":true,"id":299623,"name":"Pig","version":"2.8.20"}},"height":1,"hidden":false,"light":{"alpha":0.5,"angle":360,"animation":{"intensity":5,"reverse":false,"speed":5},"bright":0,"coloration":1,"contrast":0,"darkness":{"max":1,"min":0},"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"shadows":0},"name":"Pig","scale":1,"tint":null,"width":1,"x":2500,"y":2200},{"_id":"XjICDxbwdoeQjTwB","actorData":{},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"disposition":-1,"elevation":0,"flags":{"ddbActorFlags":{"creatureFlags":[],"creatureGroup":null,"entityTypeId":779871897,"flatAC":true,"id":16906,"name":"Goat","version":"2.8.20"}},"height":1,"hidden":false,"light":{"alpha":0.5,"angle":36