reverse":false,"speed":5},"bright":5,"color":null,"coloration":1,"contrast":0,"darkness":{"max":1,"min":0.65},"dim":10,"gradual":true,"luminosity":0.5,"saturation":0,"shadows":0},"flags":{},"hidden":false,"rotation":0,"vision":false,"walls":true,"x":3800,"y":1650},{"_id":"bWEVjhQKsyaYY67s","config":{"alpha":0.5,"angle":360,"animation":{"intensity":5,"reverse":false,"speed":5},"bright":5,"color":null,"coloration":1,"contrast":0,"darkness":{"max":1,"min":0.65},"dim":10,"gradual":true,"luminosity":0.5,"saturation":0,"shadows":0},"flags":{},"hidden":false,"rotation":0,"vision":false,"walls":true,"x":3550,"y":1550},{"_id":"0Nq58BKwRLy6bcZc","config":{"alpha":0.5,"angle":360,"animation":{"intensity":5,"reverse":false,"speed":5},"bright":5,"color":null,"coloration":1,"contrast":0,"darkness":{"max":1,"min":0.65},"dim":10,"gradual":true,"luminosity":0.5,"saturation":0,"shadows":0},"flags":{},"hidden":false,"rotation":0,"vision":false,"walls":true,"x":3383.237591911765,"y":1950.7065716911766},{"_id":"LeoqYbYYzwwaWV7Z","config":{"alpha":0.5,"angle":360,"animation":{"intensity":5,"reverse":false,"speed":5},"bright":5,"color":null,"coloration":1,"contrast":0,"darkness":{"max":1,"min":0.65},"dim":10,"gradual":true,"luminosity":0.5,"saturation":0,"shadows":0},"flags":{},"hidden":false,"rotation":0,"vision":false,"walls":true,"x":3391.549862132353,"y":2205.0953584558824},{"_id":"HhI825bDWQ2dGlPS","config":{"alpha":0.5,"angle":360,"animation":{"intensity":5,"reverse":false,"speed":5},"bright":5,"color":null,"coloration":1,"contrast":0,"darkness":{"max":1,"min":0.65},"dim":10,"gradual":true,"luminosity":0.5,"saturation":0,"shadows":0},"flags":{},"hidden":false,"rotation":0,"vision":false,"walls":true,"x":3386.6440716911766,"y":2432.3127297794117},{"_id":"gu4N2tudQPDXtCMS","config":{"alpha":0.5,"angle":360,"animation":{"intensity":5,"reverse":false,"speed":5},"bright":5,"color":null,"coloration":1,"contrast":0,"darkness":{"max":1,"min":0.65},"dim":10,"gradual":true,"luminosity":0.5,"saturation":0,"shadows":0},"flags":{},"hidden":false,"rotation":0,"vision":false,"walls":true,"x":3550,"y":2550},{"_id":"dD9IyvlGES32tLQl","config":{"alpha":0.5,"angle":270,"animation":{"intensity":5,"reverse":false,"speed":5},"bright":5,"color":null,"coloration":1,"contrast":0,"darkness":{"max":1,"min":0.65},"dim":10,"gradual":true,"luminosity":0.5,"saturation":0,"shadows":0},"flags":{},"hidden":false,"rotation":180,"vision":false,"walls":true,"x":3386.615349264706,"y":1083.6282169117646},{"_id":"kKagDWWKXH9lQh5M","config":{"alpha":0.5,"angle":360,"animation":{"intensity":5,"reverse":false,"speed":5},"bright":5,"color":null,"coloration":1,"contrast":0,"darkness":{"max":1,"min":0.65},"dim":10,"gradual":true,"luminosity":0.5,"saturation":0,"shadows":0},"flags":{},"hidden":false,"rotation":0,"vision":false,"walls":true,"x":4350,"y":1250},{"_id":"A7NXtHHBkENwY1ZY","config":{"alpha":0.5,"angle":270,"animation":{"intensity":1,"reverse":false,"speed":2,"type":"torch"},"bright":5,"color":null,"coloration":1,"contrast":0,"darkness":{"max":1,"min":0.65},"dim":10,"gradual":true,"luminosity":0.5,"saturation":0,"shadows":0},"flags":{},"hidden":false,"rotation":180,"vision":false,"walls":true,"x":1576,"y":1088},{"_id":"xRdu2p9dJUYxIn0D","config":{"alpha":0.5,"angle":360,"animation":{"intensity":5,"reverse":false,"speed":5},"bright":5,"color":null,"coloration":1,"contrast":0,"darkness":{"max":1,"min":0.65},"dim":10,"gradual":true,"luminosity":0.5,"saturation":0,"shadows":0},"flags":{},"hidden":false,"rotation":0,"vision":false,"walls":true,"x":2600,"y":1250}],"name":"Map 2: Wayside Inn","navName":"Wayside Inn","notes":[],"padding":0.25,"shiftX":42,"shiftY":28,"tiles":[],"tokenVision":true,"tokens":[{"_id":"enmdR88asdJRSCXI","actorData":{"data":{"details":{"biography":{"value":"<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"606f484c-681e-4555-aec3-3f5a315d471e\">Cooragh only emerges from the kitchen long enough to thank the adventurers and give them a piece of her special pork pie.\n<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"606f484c-681e-4555-aec3-3f5a315d471e\">It is very spicy, but delicious for those who can stomach the burn.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"606f484c-681e-4555-aec3-3f5a315d471e\">On her neck, beneath each ear, are tattoos of curved daggers.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"606f484c-681e-4555-aec3-3f5a315d471e\">If asked, she admits she got them because she knew it would upset her mother, a human from Luskan.\n<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"606f484c-681e-4555-aec3-3f5a315d471e\">It was a foolish youthful folly, she says.</li>\n</ul>\n</li>\n</ul>\n</li>\n</ul>"},"cr":"0","type":{"subtype":"Half-Orc"}},"resources":{"lair":{"value":false}}},"oldHpVal":4},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"disposition":1,"elevation":0,"flags":{"ddbActorFlags":{"creatureFlags":[],"creatureGroup":null,"entityTypeId":779871897,"flatAC":true,"id":16829,"name":"Commoner","version":"2.8.20"}},"height":1,"hidden":false,"light":{"alpha":0.5,"angle":360,"animation":{"intensity":5,"reverse":false,"speed":5},"bright":0,"color":null,"coloration":1,"contrast":0,"darkness":{"max":1,"min":0},"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"shadows":0},"name":"Cooragh Struckt","scale":1,"tint":null,"width":1,"x":1900,"y":2600},{"_id":"mUnbj6nW85ibSaWe","actorData":{"data":{"resources":{"lair":{"value":false}}},"oldHpVal":22},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"disposition":-1,"elevation":0,"flags":{"ddbActorFlags":{"creatureFlags":[],"creatureGroup":null,"entityTypeId":779871897,"flatAC":true,"id":17077,"name":"Zombie","version":"2.8.20"}},"height":1,"hidden":false,"light":{"alpha":0.5,"angle":360,"animation":{"intensity":5,"reverse":false,"speed":5},"bright":0,"coloration":1,"contrast":0,"darkness":{"max":1,"min":0},"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"shadows":0},"name":"Zombie","scale":1,"tint":null,"width":1,"x":1500,"y":1200},{"_id":"FI3oaInl75pU6AyQ","actorData":{"data":{"resources":{"lair":{"value":false}}},"oldHpVal":67},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"disposition":-1,"elevation":0,"flags":{"ddbActorFlags":{"creatureFlags":[],"creatureGroup":null,"entityTypeId":779871897,"flatAC":true,"id":17064,"name":"Wraith","version":"2.8.20"}},"height":1,"hidden":false,"light":{"alpha":0.5,"angle":360,"animation":{"intensity":5,"reverse":false,"speed":5},"bright":0,"coloration":1,"contrast":0,"darkness":{"max":1,"min":0},"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"shadows":0},"name":"Wraith","scale":1,"tint":null,"width":1,"x":2400,"y":1200},{"_id":"dbO2XQ2WQjaEf6ew","actorData":{"data":{"details":{"biography":{"value":"<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"129595e3-8b37-4ba9-9b3c-917263dec77c\">Martisha sits in the corner at a lone table, poring over records and watching the business. She answers any attempts at conversation curtly.\n<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"129595e3-8b37-4ba9-9b3c-917263dec77c\">She wants to partner with the settlers of Leilon to set up a mutual protection pact, as well as a trade pact where she sells her vegetables and livestock in return for the goods they will produce.</li>\n</ul>\n</li>\n</ul>"},"cr":"0"},"resources":{"lair":{"value":false}}},"oldHpVal":4},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"disposition":0,"elevation":0,"flags":{"ddbActorFlags":{"creatureFlags":[],"creatureGroup":null,"entityTypeId":779871897,"flatAC":true,"id":16829,"name":"Commoner","version":"2.8.20"}},"height":1,"hidden":false,"light":{"alpha":0.5,"angle":360,"animation":{"intensity":5,"reverse":false,"speed":5},"bright":0,"color":null,"coloration":1,"contrast":0,"darkness":{"max":1,"min":0},"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"shadows":0},"name":"Martisha Vinetalker","scale":1,"tint":null,"width":1,"x":1500,"y":1900},{"_id":"JGxPMiEmoyI7razt","actorData":{"data":{"details":{"biography":{"value":"<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"407d9b2c-5659-4dbe-9b38-c5a83593d47b\">Backes keeps the ale flowing all night for the adventurers.\n<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"407d9b2c-5659-4dbe-9b38-c5a83593d47b\">He tells them that he gave up a life as a privateer (that is, a pirate) to get into business on land.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"407d9b2c-5659-4dbe-9b38-c5a83593d47b\">He works the bar and assists Martisha, but he hopes to someday open his own place in Neverwinter or Waterdeep.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"407d9b2c-5659-4dbe-9b38-c5a83593d47b\">He wears a pendant around his neck in the shape of a trident, which he says the crew of his last ship wore as a way to appease the many sea gods.</li>\n</ul>\n</li>\n</ul>"},"cr":"0"},"resources":{"lair":{"value":false}}},"name":"Commoner","oldHpVal":4},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"disposition":1,"elevation":0,"flags":{"ddbActorFlags":{"creatureFlags":[],"creatureGroup":null,"entityTypeId":779871897,"flatAC":true,"id":16829,"name":"Commoner","version":"2.8.20"}},"height":1,"hidden":false,"light":{"alpha":0.5,"angle":360,"animation":{"intensity":5,"reverse":false,"speed":5},"bright":0,"color":null,"coloration":1,"contrast":0,"darkness":{"max":1,"min":0},"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"shadows":0},"name":"Bales","scale":1,"tint":null,"width":1,"x":1700,"y":2400},{"_id":"eMS6fphR3SiMBrNe","actorData":{"data":{"details":{"biography":{"value":"<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"36c02100-467e-4489-a752-0ecdf8a5b6db\">The smith who works at the Wayside Inn smithy is a strapping woman called Teega who can wield a hammer in each hand like a titan.\n<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"36c02100-467e-4489-a752-0ecdf8a5b6db\">Her anvil is forged in the shape of a dolphin, and at night she drinks at the bar with the other patrons.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"36c02100-467e-4489-a752-0ecdf8a5b6db\">She met Backes after his life as a pirate ended, and she hopes to join him in setting up a business in a city at some point.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"36c02100-467e-4489-a752-0ecdf8a5b6db\">She makes jewelry in her spare time and wears a set of bronze bracers shaped like three lightning bolts.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"36c02100-467e-4489-a752-0ecdf8a5b6db\">She proudly displays three suits of plate armor that she created, each bearing the same symbol as the design of her bracers.</li>\n</ul>\n</li>\n</ul>"},"cr":"0"},"resources":{"lair":{"value":false}}},"oldHpVal":4},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"disposition":1,"elevation":0,"flags":{"ddbActorFlags":{"creatureFlags":[],"creatureGroup":null,"entityTypeId":779871897,"flatAC":true,"id":16829,"name":"Commoner","version":"2.8.20"}},"height":1,"hidden":false,"light":{"alpha":0.5,"angle":360,"animation":{"intensity":5,"reverse":false,"speed":5},"bright":0,"color":null,"coloration":1,"contrast":0,"darkness":{"max":1,"min":0},"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"shadows":0},"name":"Teega","scale":1,"tint":null,"width":1,"x":2000,"y":2100},{"_id":"JHFSdCi57kz220Ee","actorData":{"data":{"details":{"biography":{"value":"<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"c66eb73d-38a1-46ed-8cf3-c8ea73c68b7d\">A young halfling named Silla Scalesweep sits at a table, humming to herself.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"c66eb73d-38a1-46ed-8cf3-c8ea73c68b7d\">She is traveling from Neverwinter to Leilon, hoping to get hired on as a fisher by Valdi Estapaar, the woman in charge of the fishery in the town.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"c66eb73d-38a1-46ed-8cf3-c8ea73c68b7d\">She wears her long hair in five braids atop her head, and she is very talkative.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"c66eb73d-38a1-46ed-8cf3-c8ea73c68b7d\">She also plays the harmonica quite well and is keen to have an audience.</li>\n</ul>"},"cr":"0","type":{"subtype":"Halfling"}},"resources":{"lair":{"value":false}}},"oldHpVal":4},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"disposition":1,"elevation":0,"flags":{"ddbActorFlags":{"creatureFlags":[],"creatureGroup":null,"entityTypeId":779871897,"flatAC":true,"id":16829,"name":"Commoner","version":"2.8.20"}},"height":1,"hidden":false,"light":{"alpha":0.5,"angle":360,"animation":{"intensity":5,"reverse":false,"speed":5},"bright":0,"color":null,"coloration":1,"contrast":0,"darkness":{"max":1,"min":0},"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"shadows":0},"name":"Silla Scalesweep","scale":1,"tint":null,"width":1,"x":2000,"y":1600},{"_id":"h4xUZ9Jps0QJQhor","actorData":{"data":{"details":{"biography":{"value":"<p><span style=\"color: #191813;\">Tarbin Tul</span></p>\n<ul style=\"box-sizing: border-box; user-select: text; color: #191813;\" data-content-chunk-id=\"dc3f0ee5-3f46-40fe-883a-108068f7b59f\">\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"4a53aa19-ebfe-48b4-9653-eb67251234c2\">Tarbin Tul is a traveling bard who wanders the High Road, seeking new songs to add to his already impressive repertoire.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"4a53aa19-ebfe-48b4-9653-eb67251234c2\">Tarbin sits by the fire, singing along to Silla&rsquo;s ditties on the harmonica.</li>\n<li style=\"box-sizing: border-box; user-select: text;\" data-content-chunk-id=\"4a53aa19-ebfe-48b4-9653-eb67251234c2\">He gladly buys a drink for anyone who helped drive off the undead.</li>\n</ul>"},"cr":"0","type":{"subtype":"Tarbin Tul"}},"resources":{"lair":{"value":false}}},"oldHpVal":4},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"disposition":1,"elevation":0,"flags":{"ddbActorFlags":{"creatureFlags":[],"creatureGroup":null,"entityTypeId":779871897,"flatAC":true,"id":16829,"name":"Commoner","version":"2.8.20"}},"height":1,"hidden":false,"light":{"alpha":0.5,"angle":360,"animation":{"intensity":5,"reverse":false,"speed":5},"bright":0,"color":null,"coloration":1,"contrast":0,"darkness":{"max":1,"min":0},"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"shadows":0},"name":"Tarbin Tul","scale":1,"tint":null,"width":1,"x":2000,"y":1400},{"_id":"2IBxaTaQuJF1ThLU","actorData":{"data":{"details":{"cr":"0"},"resources":{"lair":{"value":false}}},"oldHpVal":4},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"disposition":1,"elevation":0,"flags":{"ddbActorFlags":{"creatureFlags":[],"creatureGroup":null,"entityTypeId":779871897,"flatAC":true,"id":16829,"name":"Commoner","version":"2.8.20"}},"height":1,"hidden":false,"light":{"alpha":0.5,"angle":360,"animation":{"intensity":5,"reverse":false,"speed":5},"bright":0,"color":null,"coloration":1,"contrast":0,"darkness":{"max":1,"min":0},"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"shadows":0},"name":"Barmaid","scale":1,"tint":null,"width":1,"x":1600,"y":2300},{"_id":"ywXLYcV3ZJD25O9A","actorData":{"data":{"details":{"cr":"0"},"resources":{"lair":{"value":false}}},"oldHpVal":4},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"disposition":1,"elevation":0,"flags":{"ddbActorFlags":{"creatureFlags":[],"creatureGroup":null,"entityTypeId":779871897,"flatAC":true,"id":16829,"name":"Commoner","version":"2.8.20"}},"height":1,"hidden":false,"light":{"alpha":0.5,"angle":360,"animation":{"intensity":5,"reverse":false,"speed":5},"bright":0,"color":null,"coloration":1,"contrast":0,"darkness":{"max":1,"min":0},"dim":0,"gradual":true,"luminosity":0.5,"saturation":0,"shadows":0},"name":"Commoner","scale":1,"tint":null,"width":1,"x":1600,"y":1700},{"_id":"uAHd32Tbrb4g2xN6","actorData":{"data":{"details":{"cr":"0"},"resources":{"lair":{"value":false}}},"oldHpVal":4},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"disposition":1,"elevation":0,"flags":{"ddbActorFlags"