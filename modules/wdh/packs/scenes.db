ight":75,"points":[],"radius":null,"type":"r","width":45},"strokeAlpha":0,"strokeColor":"#FFFFFF","strokeWidth":8,"text":"⬆︎","textAlpha":1,"textColor":"#FFFFFF","texture":null,"x":3525,"y":3850,"z":0},{"_id":"NbIfTAaUIs33LLjz","author":"ZWZhNTMzZTE2NzI3","bezierFactor":0,"fillAlpha":0.1,"fillColor":"#FFFFFF","fillType":0,"flags":{"tagger":{}},"fontFamily":"Signika","fontSize":48,"hidden":false,"locked":false,"rotation":225,"shape":{"height":75,"points":[],"radius":null,"type":"r","width":45},"strokeAlpha":0,"strokeColor":"#FFFFFF","strokeWidth":8,"text":"⬆︎","textAlpha":1,"textColor":"#FFFFFF","texture":null,"x":3525,"y":4237.5,"z":0},{"_id":"4VodZ2ZLusSiHTsd","author":"ZWZhNTMzZTE2NzI3","bezierFactor":0,"fillAlpha":0.1,"fillColor":"#FFFFFF","fillType":0,"flags":{"perfect-vision":{"enabled":false,"fit":false,"prototype":null},"tagger":{}},"fontFamily":"Signika","fontSize":24,"hidden":true,"locked":false,"rotation":0,"shape":{"height":211,"points":[],"radius":null,"type":"r","width":900},"strokeAlpha":1,"strokeColor":"#FFFFFF","strokeWidth":8,"text":"Xanathar's location:  Roll 1d100. 01-50, Xanathar is talking to Sylgar, its pet fish in area X19. On a 51-75, Xanathar is delivering a rambling sermon to minions in the audience chamber (area X18). On a 76-90, Xanathar is watching a fight in the Pit of Blood and Fortune (area X6). On a 91-100, Xanathar is contemplating its mortality in the crypt, amid the remains of past xanathars (area X33)","textAlpha":1,"textColor":"#FFFFFF","texture":null,"x":50,"y":1387.5,"z":0},{"_id":"zrC7WHcCZNqvuH2S","author":"ZWZhNTMzZTE2NzI3","bezierFactor":0,"fillAlpha":0.1,"fillColor":"#FFFFFF","fillType":0,"flags":{"perfect-vision":{"enabled":false,"fit":false,"prototype":null},"tagger":{}},"fontFamily":"Signika","fontSize":48,"hidden":true,"locked":false,"rotation":0,"shape":{"height":88,"points":[],"radius":null,"type":"r","width":650},"strokeAlpha":1,"strokeColor":"#FFFFFF","strokeWidth":8,"text":"This tunnel goes to Skullport","textAlp