{"background":{"scaleX":1,"scaleY":1,"offsetX":-7,"offsetY":10,"rotation":0,"tint":null},"backgroundColor":"#999999","darkness":0,"drawings":[{"_id":"KD7mlUYVAaNxDBtb","author":"ZWZhNTMzZTE2NzI3","shape":{"type":"r","width":1188,"height":300,"radius":null,"points":[]},"x":262.5,"y":50,"z":0,"rotation":0,"bezierFactor":0,"fillType":0,"fillColor":"#FFFFFF","fillAlpha":0.1,"strokeWidth":8,"strokeColor":"#FFFFFF","strokeAlpha":1,"texture":null,"text":"If at any point the city watch gets involved, lord and lady cassalanter become worried that someone has caught on to their plot. They replace all guards with a bearded devil disguised as a human.","fontFamily":"Signika","fontSize":48,"textColor":"#FFFFFF","textAlpha":1,"hidden":false,"locked":false,"flags":{"tagger":{},"perfect-vision":{"enabled":false,"fit":false,"prototype":null}}},{"_id":"n4ACJVEk5oQiE7VS","author":"ZWZhNTMzZTE2NzI3","shape":{"type":"r","width":1225,"height":163,"radius":null,"points":[]},"x":237.5,"y":1987.5,"z":0,"rotation":0,"bezierFactor":0,"fillType":0,"fillColor":"#FFFFFF","fillAlpha":0.1,"strokeWidth":8,"strokeColor":"#FFFFFF","strokeAlpha":1,"texture":null,"text":"Remember to replace Willifort Crowell's token with that of a tiefling. We placed his token in C1.","fontFamily":"Signika","fontSize":48,"textColor":"#FFFFFF","textAlpha":1,"hidden":false,"locked":false,"flags":{"tagger":{},"perfect-vision":{"enabled":false,"fit":false,"prototype":null}}},{"author":"ZWZhNTMzZTE2NzI3","shape":{"type":"r","width":1225,"height":163,"radius":null,"points":[]},"x":225,"y":6062.5,"z":0,"rotation":0,"bezierFactor":0,"fillType":0,"fillColor":"#FFFFFF","fillAlpha":0.1,"strokeWidth":8,"strokeColor":"#FFFFFF","strokeAlpha":1,"texture":null,"text":"FOUNDERS DAY SPECIFIC CHARACTER NOTES","fontFamily":"Signika","fontSize":48,"textColor":"#FFFFFF","textAlpha":1,"hidden":false,"locked":false,"flags":{"tagger":{},"perfect-vision":{"enabled":false,"fit":false,"prototype":null}},"_id":"CcDS0fl6ftXdl1Po"},{"author":"ZWZhNT