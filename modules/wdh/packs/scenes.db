{"background":{"scaleX":1,"scaleY":1,"offsetX":51,"offsetY":-50,"rotation":0,"tint":null},"backgroundColor":"#999999","darkness":0,"drawings":[{"_id":"KD7mlUYVAaNxDBtb","author":"ZWZhNTMzZTE2NzI3","shape":{"type":"r","width":1188,"height":300,"radius":null,"points":[]},"x":200,"y":100,"z":0,"rotation":0,"bezierFactor":0,"fillType":0,"fillColor":"#FFFFFF","fillAlpha":0.1,"strokeWidth":8,"strokeColor":"#FFFFFF","strokeAlpha":1,"texture":null,"text":"If at any point the city watch gets involved, lord and lady cassalanter become worried that someone has caught on to their plot. They replace all guards with a bearded devil disguised as a human.","fontFamily":"Signika","fontSize":48,"textColor":"#FFFFFF","textAlpha":1,"hidden":false,"locked":false,"flags":{"tagger":{},"perfect-vision":{"enabled":false,"fit":false,"prototype":null}}},{"_id":"n4ACJVEk5oQiE7VS","author":"ZWZhNTMzZTE2NzI3","shape":{"type":"r","width":1225,"height":163,"radius":null,"points":[]},"x":175,"y":2037.5,"z":0,"rotation":0,"bezierFactor":0,"fillType":0,"fillColor":"#FFFFFF","fillAlpha":0.1,"strokeWidth":8,"strokeColor":"#FFFFFF","strokeAlpha":1,"texture":null,"text":"Remember to replace Willifort Crowell's token with that of a tiefling. We placed his token in C1.","fontFamily":"Signika","fontSize":48,"textColor":"#FFFFFF","textAlpha":1,"hidden":false,"locked":false,"flags":{"tagger":{},"perfect-vision":{"enabled":false,"fit":false,"prototype":null}}},{"author":"ZWZhNTMzZTE2NzI3","shape":{"type":"r","width":1225,"height":163,"radius":null,"points":[]},"x":162.5,"y":6112.5,"z":0,"rotation":0,"bezierFactor":0,"fillType":0,"fillColor":"#FFFFFF","fillAlpha":0.1,"strokeWidth":8,"strokeColor":"#FFFFFF","strokeAlpha":1,"texture":null,"text":"FOUNDERS DAY SPECIFIC CHARACTER NOTES","fontFamily":"Signika","fontSize":48,"textColor":"#FFFFFF","textAlpha":1,"hidden":false,"locked":false,"flags":{"tagger":{},"perfect-vision":{"enabled":false,"fit":false,"prototype":null}},"_id":"CcDS0fl6ftXdl1Po"},{"author":"ZWZhNT