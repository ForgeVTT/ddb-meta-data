ierFactor":0,"fillAlpha":0.1,"fillColor":"#FFFFFF","fillType":0,"flags":{"tagger":{}},"fontFamily":"Signika","fontSize":48,"hidden":false,"locked":false,"rotation":135,"shape":{"height":75,"points":[],"radius":null,"type":"r","width":45},"strokeAlpha":0,"strokeColor":"#FFFFFF","strokeWidth":8,"text":"⬆︎","textAlpha":1,"textColor":"#FFFFFF","texture":null,"x":5275,"y":8350,"z":0},{"_id":"rkYXcLx7OuPr5Bad","author":"ZWZhNTMzZTE2NzI3","bezierFactor":0,"fillAlpha":0.1,"fillColor":"#FFFFFF","fillType":0,"flags":{"tagger":{}},"fontFamily":"Signika","fontSize":48,"hidden":false,"locked":false,"rotation":0,"shape":{"height":75,"points":[],"radius":null,"type":"r","width":45},"strokeAlpha":0,"strokeColor":"#FFFFFF","strokeWidth":8,"text":"⬆︎","textAlpha":1,"textColor":"#FFFFFF","texture":null,"x":5875,"y":9062.5,"z":0},{"_id":"4IY5RxtbvGpfZauF","author":"ZWZhNTMzZTE2NzI3","bezierFactor":0,"fillAlpha":0.1,"fillColor":"#FFFFFF","fillType":0,"flags":{"perfect-vision":{"enabled":false,"fit":false,"prototype":null},"tagger":{}},"fontFamily":"Signika","fontSize":48,"hidden":false,"locked":false,"rotation":0,"shape":{"height":120,"points":[],"radius":null,"type":"r","width":1275},"strokeAlpha":1,"strokeColor":"#FFFFFF","strokeWidth":8,"text":"If it is Founder's Day, the black viper is hiding in an alcove putting on her mask and hood in C2","textAlpha":1,"textColor":"#FFFFFF","texture":null,"x":162.5,"y":6337.5,"z":0},{"_id":"f1kf1DG7X2hAU8YO","author":"ZWZhNTMzZTE2NzI3","bezierFactor":0,"fillAlpha":0.1,"fillColor":"#FFFFFF","fillType":0,"flags":{"perfect-vision":{"enabled":false,"fit":false,"prototype":null},"tagger":{}},"fontFamily":"Signika","fontSize":48,"hidden":false,"locked":false,"rotation":0,"shape":{"height":263,"points":[],"radius":null,"type":"r","width":1275},"strokeAlpha":1,"strokeColor":"#FFFFFF","strokeWidth":8,"text":"Lady Ammalia Cassalanter: Roll 1d100. 01-70, She's tending her butterfly garden in C25. 71-90, she's smoking on the balcony in C25a. 91-100 She's weeping before Osvaldo in the attic in area C24.","textAlpha":1,"textColor":"#FFFFFF","texture":null,"x":212.5,"y":537.5,"z":0},{"_id":"qU1XJP6W0qkxHLRg","author":"ZWZhNTMzZTE2NzI3","bezierFactor":0,"fillAlpha":0.1,"fillColor":"#FFFFFF","fillType":0,"flags":{"perfect-vision":{"enabled":false,"fit":false,"prototype":null},"tagger":{}},"fontFamily":"Signika","fontSize":48,"hidden":false,"locked":false,"rotation":0,"shape":{"height":263,"points":[],"radius":null,"type":"r","width":1275},"strokeAlpha":1,"strokeColor":"#FFFFFF","strokeWidth":8,"text":"Lord Victoro Cassalanter: Roll 1d100. 01-70 He's in his office (area C6). 71-90 He's in the reading room (area C4). 91-100 he's with Ammalia at one of her three locations.","textAlpha":1,"textColor":"#FFFFFF","texture":null,"x":225,"y":962.5,"z":0},{"_id":"fldGRVjYJWSdRt5G","author":"ZWZhNTMzZTE2NzI3","bezierFactor":0,"fillAlpha":0.1,"fillColor":"#FFFFFF","fillType":0,"flags":{"perfect-vision":{"enabled":false,"fit":false,"prototype":null},"tagger":{}},"fontFamily":"Signika","fontSize":48,"hidden":false,"locked":false,"rotation":0,"shape":{"height":263,"points":[],"radius":null,"type":"r","width":1275},"strokeAlpha":1,"strokeColor":"#FFFFFF","strokeWidth":8,"text":"Terenzio and Elzerina Cassalanter: Roll 1d100. 01-50, they're playing in their room (area C18). 51-75 They're in the library (C3). 76-100 They're chasing butterflies in the garden (area C25).","textAlpha":1,"textColor":"#FFFFFF","texture":null,"x":225,"y":1362.5,"z":0},{"_id":"YWJVyhn0XukG69Sq","author":"ZWZhNTMzZTE2NzI3","bezierFactor":0,"fillAlpha":0.1,"fillColor":"#FFFFFF","fillType":0,"flags":{"perfect-vision":{"enabled":false,"fit":false,"prototype":null},"tagger":{}},"fontFamily":"Signika","fontSize":48,"hidden":false,"locked":false,"rotation":0,"shape":{"height":225,"points":[],"radius":null,"type":"r","width":1275},"strokeAlpha":1,"strokeColor":"#FFFFFF","strokeWidth":8,"text":"The below three head servants are noted as cult fanatics but are in disguise as tiefling servants. Replace their tokens with the image of a tiefling.","textAlpha":1,"textColor":"#FFFFFF","texture":null,"x":213,"y":2338,"z":0},{"_id":"QIDBmp9S3EXI8BvK","author":"ZWZhNTMzZTE2NzI3","bezierFactor":0,"fillAlpha":0.1,"fillColor":"#FFFFFF","fillType":0,"flags":{"perfect-vision":{"enabled":false,"fit":false,"prototype":null},"tagger":{}},"fontFamily":"Signika","fontSize":48,"hidden":false,"locked":false,"rotation":0,"shape":{"height":175,"points":[],"radius":null,"type":"r","width":1287},"strokeAlpha":1,"strokeColor":"#FFFFFF","strokeWidth":8,"text":"On founders day several nobles and 100 of Waterdeep's poorest comoners gather on the lawn, ballroom, the entry, dining room and foyer","textAlpha":1,"textColor":"#FFFFFF","texture":null,"x":188,"y":6613,"z":0},{"_id":"zFaTb3In6O0pPkeI","author":"ZWZhNTMzZTE2NzI3","bezierFactor":0,"fillAlpha":0.1,"fillColor":"#FFFFFF","fillType":0,"flags":{"perfect-vision":{"enabled":false,"fit":false,"prototype":null},"tagger":{}},"fontFamily":"Signika","fontSize":48,"hidden":false,"locked":false,"rotation":0,"shape":{"height":413,"points":[],"radius":null,"type":"r","width":1302},"strokeAlpha":1,"strokeColor":"#FFFFFF","strokeWidth":8,"text":"Four doppelgangers from the Yawning Portal have slipped into the party disguised as nobles. Their leader, Bonnie (see “Familiar Faces” journal entry), poses as a minor noblewoman going by the name Lymeria Lhaurilstar; she was hoping to have a fun night at the party, but she’s willing to help the characters if they need aid.  NOTE: REMEMBER TO CHANGE THE TOKEN PICTURE TO A NOBLE.","textAlpha":1,"textColor":"#FFFFFF","texture":null,"x":188,"y":6925,"z":0}],"flags":{"ddb":{"bookCode":"wdh","cobaltId":null,"contentChunkId":"f9a869c9-cd1c-4b3f-8b3b-613624572508","ddbId":13063,"foundryVersion":"10.291","noteInfos":[{"cobaltId":null,"contentChunkIdStart":"003b7f15-fc01-42cc-a344-0c9a0b370e40","contentChunkIdStop":"EOF","ddbId":62,"parentId":561,"sceneName":"Cassalanter Villa","slug":"hell-of-