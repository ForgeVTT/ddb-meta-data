jp7EFmyEqpsOyS2","flags":{"ddb":{"bookCode":"wdh","cobaltId":null,"contentChunkId":null,"ddbId":52,"duplicate":false,"img":false,"labelName":"Leaving the Vault","linkName":"Vault of Dragons","note":false,"parentId":558,"slug":"dragon-season#VaultofDragons","slugLink":"LeavingtheVault"}},"iconSize":100,"label":"Leaving the Vault","textAnchor":1,"textColor":"#FFFFFF","texture":{"offsetX":0,"offsetY":0,"rotation":0,"scaleX":1,"scaleY":1,"src":"icons/svg/book.svg","tint":null},"x":253,"y":714},{"_id":"3Akzq5lc5mGrIWCh","flags":{"ddb":{"bookCode":"wdh","cobaltId":null,"contentChunkId":null,"ddbId":52,"duplicate":false,"img":false,"labelName":"Faction Reinforcements","linkName":"Vault of Dragons","note":false,"parentId":558,"slug":"dragon-season#VaultofDragons","slugLink":"FactionReinforcements"}},"iconSize":100,"label":"Faction Reinforcements","textAnchor":1,"textColor":"#FFFFFF","texture":{"offsetX":0,"offsetY":0,"rotation":0,"scaleX":1,"scaleY":1,"src":"icons/svg/book.svg","tint":null},"x":5145,"y":479}],"padding":0.25,"tiles":[],"tokenVision":true,"tokens":[{"_id":"o88xAhGukt5cmiNU","actorData":{"flags":{"midi-qol":{"concentration-damage":0}}},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"disposition":-1,"elevation":0,"flags":{"ddbActorFlags":{"creatureFlags":[],"creatureGroupId":null,"entityTypeId":779871897,"flatAC":true,"id":16808,"isLegacy":false,"name":"Black Pudding","version":"3.4.15"}},"height":2,"hidden":true,"light":{"alpha":0.5,"angle":360,"animation":{"intensity":5,"reverse":false,"speed":5,"type":null},"attenuation":0.5,"bright":0,"color":null,"coloration":1,"contrast":0,"darkness":{"max":1,"min":0},"dim":0,"luminosity":0.5,"saturation":0,"shadows":0},"name":"Black Pudding","width":2,"x":3000,"y":1500},{"_id":"ZUSLYfL5nTkitOJ0","actorData":{"flags":{"ddbimporter":{"keepItems":true},"midi-qol":{"concentration-damage":0}},"name":"Barok Clanghammer","system":{"attributes":{"hp":{"temp":null,"tempmax":null},"init":{"bonus":null}},"details":{"biography":{"value":"<section class=\"secret\" id=\"secret-9rV7j7b8bmd9mtmL\"><p><strong>GM Notes :</strong></p><p>@UUID[JournalEntry.DnFe3Dlha8I2S1um]{Aurinax}</p><p dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 0pt\"><span style=\"vertical-align:baseline\"><strong>Aurinax </strong>is a male adult gold dragon who can freely ignore <em>Ahghairon's dragonward</em> and reside in the city. Maaril, the archmage who last wielded the <em>dragonstaff of Ahghairon</em>, was Aurinax's friend, and invited the dragon to stay with him in the city's Dragon Tower. Shortly before the Spellplague, Maaril went mad and left Waterdeep, entrusting the <em>dragonstaff of Ahghairon</em> to Aurinax.</span></p><p dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 0pt\"><span style=\"vertical-align:baseline\"><br></span></p><p dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 0pt\"><span style=\"vertical-align:baseline\">When Dagult Neverember became the Open Lord of Waterdeep, he cut a deal with the dragon. Under its terms, Aurinax could keep the <em>dragonstaff of Ahghairon</em> in exchange for guarding a vault beneath the city. When Neverember eventually removed the treasure from the vault, Aurinax and the<em> dragonstaff </em>could return to the Dragon Tower. As it happens, no one has come to remove the treasure, and the faithful Aurinax has remained in the vault. The vault is warded against scrying magic, and there's no one left in Waterdeep who knows about Aurinax or the whereabouts of the <em>dragonstaff</em>.</span></p><p dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 0pt\"></p><p dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 0pt\">He often assumes the form of an elderly gold dwarf named Barok Clanghammer, who uses the <em>dragonstaff </em>as a walking stick.</p></section>"}},"quantity":["1","1","1","1","1"],"uses":{"max":"3","value":"3"}}},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"disposition":-1,"elevation":0,"flags":{"ddbActorFlags":{"creatureFlags":[],"creatureGroupId":null,"entityTypeId":779871897,"flatAC":false,"id":16769,"isLegacy":false,"keepItems":true,"name":"Adult Gold Dragon","version":"3.4.15"},"monks-bloodsplats":{"bloodsplat-colour":""}},"height":1,"hidden":false,"light":{"alpha":0.5,"angle":360,"animation":{"intensity":5,"reverse":false,"speed":5,"type":null},"attenuation":0.5,"bright":0,"color":null,"coloration":1,"contrast":0,"darkness":{"max":1,"min":0},"dim":0,"luminosity":0.5,"saturation":0,"shadows":0},"name":"Barok Clanghammer","width":1,"x":3700,"y":2600},{"_id":"O6jVfPbC76Fohs0t","actorData":{"flags":{"ddbimporter":{"keepItems":true},"midi-qol":{"concentration-damage":0}},"system":{"attributes":{"hp":{"temp":null,"tempmax":null},"init":{"bonus":null}},"details":{"biography":{"value":"<section class=\"secret\" id=\"secret-9rV7j7b8bmd9mtmL\"><p><strong>GM Notes :</strong></p><p>@UUID[JournalEntry.DnFe3Dlha8I2S1um]{Aurinax}</p><p dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 0pt\"><span style=\"vertical-align:baseline\"><strong>Aurinax </strong>is a male adult gold dragon who can freely ignore <em>Ahghairon's dragonward</em> and reside in the city. Maaril, the archmage who last wielded the <em>dragonstaff of Ahghairon</em>, was Aurinax's friend, and invited the dragon to stay with him in the city's Dragon Tower. Shortly before the Spellplague, Maaril went mad and left Waterdeep, entrusting the <em>dragonstaff of Ahghairon</em> to Aurinax.</span></p><p dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 0pt\"><span style=\"vertical-align:baseline\"><br></span></p><p dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 0pt\"><span style=\"vertical-align:baseline\">When Dagult Neverember became the Open Lord of Waterdeep, he cut a deal with the dragon. Under its terms, Aurinax could keep the <em>dragonstaff of Ahghairon</em> in exchange for guarding a vault beneath the city. When Neverember eventually removed the treasure from the vault, Aurinax and the<em> dragonstaff </em>could return to the Dragon Tower. As it happens, no one has come to remove the treasure, and the faithful Aurinax has remained in the vault. The vault is warded against scrying magic, and there's no one left in Waterdeep who knows about Aurinax or the whereabouts of the <em>dragonstaff</em>.</span></p><p dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 0pt\"></p><p dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 0pt\">He often assumes the form of an elderly gold dwarf named Barok Clanghammer, who uses the <em>dragonstaff </em>as a walking stick.</p></section>"}},"quantity":["1","1","1","1","1"],"uses":{"max":"3","value":"3"}}},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"disposition":-1,"elevation":0,"flags":{"ddbActorFlags":{"creatureFlags":[],"creatureGroupId":null,"entityTypeId":779871897,"flatAC":false,"id":16769,"isLegacy":false,"keepItems":true,"name":"Adult Gold Dragon","version":"3.4.15"}},"height":3,"hidden":true,"light":{"alpha":0.5,"angle":360,"animation":{"intensity":5,"reverse":false,"speed":5,"type":null},"attenuation":0.5,"bright":0,"color":null,"coloration":1,"contrast":0,"darkness":{"max":1,"min":0},"dim":0,"luminosity":0.5,"saturation":0,"shadows":0},"name":"Adult Gold Dragon","width":3,"x":4000,"y":3500},{"_id":"q3iTQQ6DDe3mp0Vp","actorData":{"flags":{"midi-qol":{"concentration-damage":0}}},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"disposition":-1,"elevation":0,"flags":{"ddbActorFlags":{"creatureFlags":[],"creatureGroupId":null,"entityTypeId":779871897,"flatAC":false,"id":16817,"isLegacy":false,"name":"Bugbear","version":"3.4.15"}},"height":1,"hidden":true,"light":{"alpha":0.5,"angle":360,"animation":{"intensity":5,"reverse":false,"speed":5,"type":null},"attenuation":0.5,"bright":0,"color":null,"coloration":1,"contrast":0,"darkness":{"max":1,"min":