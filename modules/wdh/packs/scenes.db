{"background":{"scaleX":1,"scaleY":1,"offsetX":-38,"offsetY":6,"rotation":0,"tint":null},"backgroundColor":"#999999","darkness":0.7,"drawings":[{"_id":"wmOKYLlMYHCgO0Fn","author":"ZWZhNTMzZTE2NzI3","shape":{"type":"r","width":694,"height":268,"radius":null,"points":[]},"x":2263,"y":275,"z":0,"rotation":0,"bezierFactor":0,"fillType":0,"fillColor":"#FFFFFF","fillAlpha":0.1,"strokeWidth":8,"strokeColor":"#FFFFFF","strokeAlpha":1,"texture":null,"text":"Note to DM: If Krentz survived the fight at the yawning portal, he will be here, in Q5.","fontFamily":"Signika","fontSize":48,"textColor":"#FFFFFF","textAlpha":1,"hidden":true,"locked":false,"flags":{"tagger":{}}},{"_id":"lBqg1RQdMmTyRYpI","author":"ZWZhNTMzZTE2NzI3","shape":{"type":"r","width":673,"height":762,"radius":null,"points":[]},"x":88,"y":938,"z":0,"rotation":0,"bezierFactor":0,"fillType":0,"fillColor":"#FFFFFF","fillAlpha":0.1,"strokeWidth":8,"strokeColor":"#FFFFFF","strokeAlpha":1,"texture":null,"text":"Clarification Note to DM: Stairs, indicated by repeated parallel lines that get longer or shorter.  Going up the stairs indicates moving from shorter toward longer lines. Down the stairs is going longer to shorter. For example, going from northwest Q2 toward Q4 moves down the stairs. For clarity, arrows have been added to this map that will always point in the direction that the stairs go \"UP.\"","fontFamily":"Signika","fontSize":48,"textColor":"#FFFFFF","textAlpha":1,"hidden":true,"locked":false,"flags":{"tagger":{}}},{"_id":"sE7Kr1AAwGvXYNaM","author":"ZWZhNTMzZTE2NzI3","shape":{"type":"r","width":256,"height":100,"radius":null,"points":[]},"x":2375,"y":2500,"z":0,"rotation":0,"bezierFactor":0,"fillType":0,"fillColor":"#FFFFFF","fillAlpha":0.1,"strokeWidth":8,"strokeColor":"#FFFFFF","strokeAlpha":1,"texture":null,"text":"Turn on light effect in Q11 when Nihiloor/Mind Flayer leaves for nice portal effect.","fontFamily":"Signika","fontSize":20,"textColor":"#FFFFFF","textAlpha":1,"hidden":true,"locked":false,"f