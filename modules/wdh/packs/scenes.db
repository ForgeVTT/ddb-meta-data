"coloration":1,"dim":0,"attenuation":0.5,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"type":null,"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}}},{"_id":"GnEf2ZNKJqEUCfTu","name":"Barok Clanghammer","width":1,"height":1,"x":3700,"y":2600,"disposition":-1,"flags":{"monks-bloodsplats":{"bloodsplat-colour":""},"ddbActorFlags":{"id":16769,"entityTypeId":779871897,"creatureGroupId":null,"creatureFlags":[],"version":"3.4.15","isLegacy":false,"flatAC":false,"keepItems":true,"name":"Adult Gold Dragon"}},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"elevation":0,"hidden":false,"actorData":{"flags":{"midi-qol":{"concentration-damage":0},"ddbimporter":{"keepItems":true}},"system":{"attributes":{"hp":{"temp":null,"tempmax":null},"init":{"bonus":null}},"quantity":["1","1","1","1","1"],"details":{"biography":{"value":"<section class=\"secret\" id=\"secret-9rV7j7b8bmd9mtmL\"><p><strong>GM Notes :</strong></p><p>@UUID[JournalEntry.DnFe3Dlha8I2S1um]{Aurinax}</p><p dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 0pt\"><span style=\"vertical-align:baseline\"><strong>Aurinax </strong>is a male adult gold dragon who can freely ignore <em>Ahghairon's dragonward</em> and reside in the city. Maaril, the archmage who last wielded the <em>dragonstaff of Ahghairon</em>, was Aurinax's friend, and invited the dragon to stay with him in the city's Dragon Tower. Shortly before the Spellplague, Maaril went mad and left Waterdeep, entrusting the <em>dragonstaff of Ahghairon</em> to Aurinax.</span></p><p dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 0pt\"><span style=\"vertical-align:baseline\"><br></span></p><p dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 0pt\"><span style=\"vertical-align:baseline\">When Dagult Neverember became the Open Lord of Waterdeep, he cut a deal with the dragon. Under its terms, Aurinax could keep the <em>dragonstaff of Ahghairon</em> in exchange for guarding a vault beneath the city. When Neverember eventually removed the treasure from the vault, Aurinax and the<em> dragonstaff </em>could return to the Dragon Tower. As it happens, no one has come to remove the treasure, and the faithful Aurinax has remained in the vault. The vault is warded against scrying magic, and there's no one left in Waterdeep who knows about Aurinax or the whereabouts of the <em>dragonstaff</em>.</span></p><p dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 0pt\"></p><p dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 0pt\">He often assumes the form of an elderly gold dwarf named Barok Clanghammer, who uses the <em>dragonstaff </em>as a walking stick.</p></section>"}},"uses":{"value":"3","max":"3"}},"name":"Barok Clanghammer"},"light":{"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"attenuation":0.5,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"type":null,"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}}},{"_id":"VKgiAgR58mp7o310","name":"Adult Gold Dragon","width":3,"height":3,"x":4000,"y":3500,"disposition":-1,"flags":{"ddbActorFlags":{"id":16769,"entityTypeId":779871897,"creatureGroupId":null,"creatureFlags":[],"version":"3.4.15","isLegacy":false,"flatAC":false,"keepItems":true,"name":"Adult Gold Dragon"}},"actorLink":false,"bar1":{"attribute":"attributes.hp"},"elevation":0,"hidden":true,"actorData":{"flags":{"midi-qol":{"concentration-damage":0},"ddbimporter":{"keepItems":true}},"system":{"attributes":{"hp":{"temp":null,"tempmax":null},"init":{"bonus":null}},"quantity":["1","1","1","1","1"],"uses":{"value":"3","max":"3"},"details":{"biography":{"value":"<section class=\"secret\" id=\"secret-9rV7j7b8bmd9mtmL\"><p><strong>GM Notes :</strong></p><p>@UUID[JournalEntry.DnFe3Dlha8I2S1um]{Aurinax}</p><p dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 0pt\"><span style=\"vertical-align:baseline\"><strong>Aurinax </strong>is a male adult gold dragon who can freely ignore <em>Ahghairon's dragonward</em> and reside in the city. Maaril, the archmage who last wielded the <em>dragonstaff of Ahghairon</em>, was Aurinax's friend, and invited the dragon to stay with him in the city's Dragon Tower. Shortly before the Spellplague, Maaril went mad and left Waterdeep, entrusting the <em>dragonstaff of Ahghairon</em> to Aurinax.</span></p><p dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 0pt\"><span style=\"vertical-align:baseline\"><br></span></p><p dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 0pt\"><span style=\"vertical-align:baseline\">When Dagult Neverember became the Open Lord of Waterdeep, he cut a deal with the dragon. Under its terms, Aurinax could keep the <em>dragonstaff of Ahghairon</em> in exchange for guarding a vault beneath the city. When Neverember eventually removed the treasure from the vault, Aurinax and the<em> dragonstaff </em>could return to the Dragon Tower. As it happens, no one has come to remove the treasure, and the faithful Aurinax has remained in the vault. The vault is warded against scrying magic, and there's no one left in Waterdeep who knows about Aurinax or the whereabouts of the <em>dragonstaff</em>.</span></p><p dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 0pt\"></p><p dir=\"ltr\" style=\"line-height: 1.38; margin-top: 0pt; margin-bottom: 0pt\">He often assumes the form of an elderly gold dwarf named Barok Clanghammer, who uses the <em>dragonstaff </em>as a walking stick.</p></section>"}}}},"light":{"alpha":0.5,"angle":360,"bright":0,"color":null,"coloration":1,"dim":0,"attenuation":0.5,"luminosity":0.5,"saturation":0,"contrast":0,"shadows":0,"animation":{"type":null,"speed":5,"intensity":5,"reverse":false},"darkness":{"min":0,"max":1}}},{"_id":"7tFbZv9ZGPhgOWk1","name":"Thug","width":1,"height":1,"x":100,"y":2800,"disposition":-1,"flags":{"ddbActorFlags":{"id":