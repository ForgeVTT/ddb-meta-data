0},{"_id":"pOhmwl1F20BcDfmF","author":"ZWZhNTMzZTE2NzI3","bezierFactor":0,"fillAlpha":0.1,"fillColor":"#FFFFFF","fillType":0,"flags":{"perfect-vision":{"enabled":false,"fit":false,"prototype":null},"tagger":{}},"fontFamily":"Signika","fontSize":48,"hidden":true,"locked":false,"rotation":0,"shape":{"height":338,"points":[],"radius":null,"type":"r","width":688},"strokeAlpha":1,"strokeColor":"#FFFFFF","strokeWidth":8,"text":"There are 4d6 bandits at the Krakens Folly (D1) at any given time.","textAlpha":1,"textColor":"#FFFFFF","texture":null,"x":3100,"y":4800,"z":0},{"_id":"lXlMwaV9EJRxAsyR","author":"ZWZhNTMzZTE2NzI3","bezierFactor":0,"fillAlpha":0.1,"fillColor":"#FFFFFF","fillType":0,"flags":{"perfect-vision":{"enabled":false,"fit":false,"prototype":null},"tagger":{}},"fontFamily":"Signika","fontSize":48,"hidden":true,"locked":false,"rotation":0,"shape":{"height":509,"points":[],"radius":null,"type":"r","width":720},"strokeAlpha":1,"strokeColor":"#FFFFFF","strokeWidth":8,"text":"As the characters leave the Fuoco residence, with or without Agorn as their prisoner, they are surrounded by nine Zhentarim thugs. The thugs fight to the death while Agorn tries to escape","textAlpha":1,"textColor":"#FFFFFF","texture":null,"x":513,"y":2313,"z":0},{"_id":"hB2FKDwKmHeV8Z31","author":"ZWZhNTMzZTE2NzI3","bezierFactor":0,"fillAlpha":0.1,"fillColor":"#FFFFFF","fillType":0,"flags":{"perfect-vision":{"enabled":false,"fit":false,"prototype":null},"tagger":{}},"fontFamily":"Signika","fontSize":48,"hidden":true,"locked":false,"rotation":0,"shape":{"height":788,"points":[],"radius":null,"type":"r","width":813},"strokeAlpha":1,"strokeColor":"#FFFFFF","strokeWidth":8,"text":"If the characters find themselves outmatched by the Zhents, help comes in two forms. Two Harper spies sent by Remallia Haventree (see appendix B) appear on the scene. Their names are Salazar Lorrance (CG male Tethyrian human) and Mavia Oxlander (NG female Chondathan human). If the battle doesn’t turn quickly in the party’s favor, Grinda Garloth (see area D2) appears and uses her magic to aid them.","textAlpha":1,"textColor":"#FFFFFF","texture":null,"x":425,"y":3350,"z":0}],"flags":{"ddb":{"bookCode":"wdh","cobaltId":null,"contentChunkId":"ddb-missing-wdh-103049","ddbId":103049,"foundryVersion":"10.291","noteInfos":[{"cobaltId":null,"contentChunkIdStart":"3a0532a4-9c1d-45c9-8280-167eb4b47e9c","contentChunkIdStop":"6126f8c9-17ed-451c-91fc-208f0ab97272","ddbId":42,"parentId":558,"sceneName":"Encounter 2: Mistshore","slug":"dragon-season#Encounter2Mistshore","splitTag":"h4","tagIdFirst":"D1KrakensFolly","tagIdLast":"MistshoreSpring"},{"cobaltId":null,"contentChunkIdStart":"6126f8c9-17ed-451c-91fc-208f0ab97272","contentChunkIdStop":"EOF","ddbId":42,"parentId":558,"sceneName":"Encounter 2: Mistshore","slug":"dragon-season#Encounter2Mistshore","splitTag":"h3","tagIdFirst":"MistshoreSpring","tagIdLast":""},{"cobaltId":null,"contentChunkIdStart":"f9ec97c9-49dd-40c1-8093-4d05ecd18b7f","contentChunkIdStop":"EOF","ddbId":43,"parentId":558,"sceneName":"Encounter 3: Street Chase","slug":"dragon-season#Encounter3StreetChase","splitTag":"h3","tagIdFirst":"StreetChaseSpring","tagIdLast":""},{"cobaltId":null,"contentChunkIdStart":"b311ccf1-8b89-4485-9d38-83a75f69f7ef","contentChunkIdStop":"EOF","ddbId":45,"parentId":558,"sceneName":"Encounter 5: Rooftop Chase","slug":"dragon-season#Encounter5RooftopChase","splitTag":"h3","tagIdFirst":"RooftopChaseSummer","tagIdLast":""}],"parentId":558,"versions":{"ddbMetaData":{"bookCode":"wdh","contentChunkId":"ddb-missing-wdh-103049","drawings":"0.3.24","foundry":"10.291","lastUpdate":"0.3.24","lights":"0.3.24","name":"Mistshore (Winter)","notes":"0.3.24","tokens":"0.3.24","walls":"0.3.24"}}},"ddbimporter":{"version":"3.4.14"},"dynamic-illumination":[],"perfect-vision":{"darknessColor":"","daylightColor":"","fogRevealed":false},"stairways":[]},"globalLight":false,"globalLightThreshold":null,"grid":{"alpha":0,"color":"#000000","distance":5,"size":100,"type":1,"u