2NzI3","shape":{"type":"r","width":688,"height":338,"radius":null,"points":[]},"x":3100,"y":4800,"z":0,"rotation":0,"bezierFactor":0,"fillType":0,"fillColor":"#FFFFFF","fillAlpha":0.1,"strokeWidth":8,"strokeColor":"#FFFFFF","strokeAlpha":1,"texture":null,"text":"There are 4d6 bandits at the Krakens Folly (D1) at any given time.","fontFamily":"Signika","fontSize":48,"textColor":"#FFFFFF","textAlpha":1,"hidden":true,"locked":false,"flags":{"tagger":{},"perfect-vision":{"enabled":false,"fit":false,"prototype":null}},"_id":"b95PLZ71q4pMUZ5x"},{"_id":"MINwSDDomfInywRS","author":"ZWZhNTMzZTE2NzI3","shape":{"type":"r","width":720,"height":509,"radius":null,"points":[]},"x":513,"y":2313,"z":0,"rotation":0,"bezierFactor":0,"fillType":0,"fillColor":"#FFFFFF","fillAlpha":0.1,"strokeWidth":8,"strokeColor":"#FFFFFF","strokeAlpha":1,"texture":null,"text":"As the characters leave the Fuoco residence, with or without Agorn as their prisoner, they are surrounded by nine Zhentarim thugs. The thugs fight to the death while Agorn tries to escape","fontFamily":"Signika","fontSize":48,"textColor":"#FFFFFF","textAlpha":1,"hidden":true,"locked":false,"flags":{"tagger":{},"perfect-vision":{"enabled":false,"fit":false,"prototype":null}}},{"author":"ZWZhNTMzZTE2NzI3","shape":{"type":"r","width":813,"height":788,"radius":null,"points":[]},"x":425,"y":3350,"z":0,"rotation":0,"bezierFactor":0,"fillType":0,"fillColor":"#FFFFFF","fillAlpha":0.1,"strokeWidth":8,"strokeColor":"#FFFFFF","strokeAlpha":1,"texture":null,"text":"If the characters find themselves outmatched by the Zhents, help comes in two forms. Two Harper spies sent by Remallia Haventree (see appendix B) appear on the scene. Their names are Salazar Lorrance (CG male Tethyrian human) and Mavia Oxlander (NG female Chondathan human). If the battle doesn’t turn quickly in the party’s favor, Grinda Garloth (see area D2) appears and uses her magic to aid them.","fontFamily":"Signika","fontSize":48,"textColor":"#FFFFFF","textAlpha":1,"hidden":true,"locked":false,"flags":{"tagger":{},"perfect-vision":{"enabled":false,"fit":false,"prototype":null}},"_id":"c9S6naQupU26QaIf"}],"flags":{"ddb":{"bookCode":"wdh","ddbId":103049,"cobaltId":null,"parentId":558,"contentChunkId":"ddb-missing-wdh-103049","foundryVersion":"10.291","versions":{"ddbMetaData":{"name":"Mistshore (Winter)","bookCode":"wdh","contentChunkId":"ddb-missing-wdh-103049","lastUpdate":"0.3.24","notes":"0.3.24","tokens":"0.3.24","walls":"0.3.24","lights":"0.3.24","drawings":"0.3.24","foundry":"10.291"}},"noteInfos":[{"ddbId":42,"cobaltId":null,"parentId":558,"splitTag":"h4","slug":"dragon-season#Encounter2Mistshore","tagIdFirst":"D1KrakensFolly","contentChunkIdStart":"3a0532a4-9c1d-45c9-8280-167eb4b47e9c","tagIdLast":"MistshoreSpring","contentChunkIdStop":"6126f8c9-17ed-451c-91fc-208f0ab97272","sceneName":"Encounter 2: Mistshore"},{"ddbId":42,"cobaltId":null,"parentId":558,"splitTag":"h3","slug":"dragon-season#Encounter2Mistshore","tagIdFirst":"MistshoreSpring","contentChunkIdStart":"6126f8c9-17ed-451c-91fc-208f0ab97272","tagIdLast":"","contentChunkIdStop":"EOF","sceneName":"Encounter 2: Mistshore"},{"ddbId":43,"cobaltId":null,"parentId":558,"splitTag":"h3","slug":"dragon-season#Encounter3StreetChase","tagIdFirst":"StreetChaseSpring","contentChunkIdStart":"f9ec97c9-49dd-40c1-8093-4d05ecd18b7f","tagIdLast":"","contentChunkIdStop":"EOF","sceneName":"Encounter 3: Street Chase"},{"ddbId":45,"cobaltId":null,"parentId":558,"splitTag":"h3","slug":"dragon-season#Encounter5RooftopChase","tagIdFirst":"RooftopChaseSummer","contentChunkIdStart":"b311ccf1-8b89-4485-9d38-83a75f69f7ef","tagIdLast":"","contentChunkIdStop":"EOF","sceneName":"Encounter 5: Rooftop Chase"}]},"stairways":[],"perfect-vision":{"fogRevealed":false,"daylightColor":"","darknessColor":""},"dynamic-illumination":[],"ddbimporter":{"version":"3.4.14"}},"globalLight":false,"globalLightThreshold":null,"grid":{"type":1,"size":100,"color":"#000000","alpha":0,"distance":5,"units":"ft"},"height":3719