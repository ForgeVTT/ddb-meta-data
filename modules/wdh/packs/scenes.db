e":{"height":75,"points":[],"radius":null,"type":"r","width":45},"strokeAlpha":0,"strokeColor":"#FFFFFF","strokeWidth":8,"text":"⬆︎","textAlpha":1,"textColor":"#FFFFFF","texture":null,"x":3512.5,"y":3850,"z":0},{"_id":"uegfamHqsZ6l0843","author":"ZWZhNTMzZTE2NzI3","bezierFactor":0,"fillAlpha":0.1,"fillColor":"#FFFFFF","fillType":0,"flags":{"tagger":{}},"fontFamily":"Signika","fontSize":48,"hidden":false,"locked":false,"rotation":225,"shape":{"height":75,"points":[],"radius":null,"type":"r","width":45},"strokeAlpha":0,"strokeColor":"#FFFFFF","strokeWidth":8,"text":"⬆︎","textAlpha":1,"textColor":"#FFFFFF","texture":null,"x":3512.5,"y":4237.5,"z":0},{"_id":"fmKw6i6hDXoPAJoq","author":"ZWZhNTMzZTE2NzI3","bezierFactor":0,"fillAlpha":0.1,"fillColor":"#FFFFFF","fillType":0,"flags":{"perfect-vision":{"enabled":false,"fit":false,"prototype":null},"tagger":{}},"fontFamily":"Signika","fontSize":24,"hidden":true,"locked":false,"rotation":0,"shape":{"height":211,"points":[],"radius":null,"type":"r","width":900},"strokeAlpha":1,"strokeColor":"#FFFFFF","strokeWidth":8,"text":"Xanathar's location:  Roll 1d100. 01-50, Xanathar is talking to Sylgar, its pet fish in area X19. On a 51-75, Xanathar is delivering a rambling sermon to minions in the audience chamber (area X18). On a 76-90, Xanathar is watching a fight in the Pit of Blood and Fortune (area X6). On a 91-100, Xanathar is contemplating its mortality in the crypt, amid the remains of past xanathars (area X33)","textAlpha":1,"textColor":"#FFFFFF","texture":null,"x":37.5,"y":1387.5,"z":0},{"_id":"QJCv1Hw49eMPFyY2","author":"ZWZhNTMzZTE2NzI3","bezierFactor":0,"fillAlpha":0.1,"fillColor":"#FFFFFF","fillType":0,"flags":{"perfect-vision":{"enabled":false,"fit":false,"prototype":null},"tagger":{}},"fontFamily":"Signika","fontSize":48,"hidden":true,"locked":false,"rotation":0,"shape":{"height":88,"points":[],"radius":null,"type":"r","width":650},"strokeAlpha":1,"strokeColor":"#FFFFFF","strokeWidth":8,"text":"This tunnel goes to Skullport","textAlpha":1,"textColor":"#FFFFFF","texture":null,"x":4275,"y":3262.5,"z":0},{"_id":"a7PjUWwYbZUEnbSt","author":"ZWZhNTMzZTE2NzI3","bezierFactor":0,"fillAlpha":0.1,"fillColor":"#FFFFFF","fillType":0,"flags":{"perfect-vision":{"enabled":false,"fit":false,"prototype":null},"tagger":{}},"fontFamily":"Signika","fontSize":24,"hidden":true,"locked":false,"rotation":0,"shape":{"height":75,"points":[],"radius":null,"type":"r","width":963},"strokeAlpha":1,"strokeColor":"#FFFFFF","strokeWidth":8,"text":"When they're not watching a tournament in the arena (area X6) or listening to Xanathar give a speech in the audience chamber (area X18), ten human bandits are in area X9","textAlpha":1,"textColor":"#FFFFFF","texture":null,"x":25,"y":2012.5,"z":0},{"_id":"JzE0H8dudNOrdDbu","author":"ZWZhNTMzZTE2NzI3","bezierFactor":0,"fillAlpha":0.1,"fillColor":"#FFFFFF","fillType":0,"flags":{"perfect-vision":{"enabled":false,"fit":false,"prototype":null},"tagger":{}},"fontFamily":"Signika","fontSize":24,"hidden":true,"locked":false,"rotation":0,"shape":{"height":125,"points":[],"radius":null,"type":"r","width":975},"strokeAlpha":1,"strokeColor":"#FFFFFF","strokeWidth":8,"text":"If he is not with Xanathar in the arena (Area X6), Ahmaergo is conducting a routine inspection of the dungeon in X17. If he sees intruders and is outnumbered, Ahmaergo retreats to area X22, heads downstairs to gather reingorcements from area X28.","textAlpha":1,"textColor":"#FFFFFF","texture":null,"x":38,"y":2313,"z":0}],"flags":{"ddb":{"bookCode":"wdh","cobaltId":null,"contentChunkId":"f9a869c9-cd1c-4b3f-8b3b-613624572508","ddbId":13058,"foundryVersion":"10.291","noteInfos":[{"cobaltId":null,"contentChunkIdStart":"77afeff5-d43b-48cd-b57c-a54ac41bba93","contentChunkIdStop":"EOF","ddbId":57,"parentId":560,"sceneName":"Xanathars Lair","slug":"spring-madness#XanatharsLair","splitTag":"h4","tagIdFirst":"X1StaircaseofEyes","tagIdLast":""}],"parentId":560,"versions":{"ddbMetaData":{"bookCode":"wdh","contentChunkId":"f9a