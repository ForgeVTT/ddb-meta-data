-vision":{"enabled":false,"fit":false,"prototype":null}}},{"author":"ZWZhNTMzZTE2NzI3","shape":{"type":"r","width":963,"height":75,"radius":null,"points":[]},"x":25,"y":2012.5,"z":0,"rotation":0,"bezierFactor":0,"fillType":0,"fillColor":"#FFFFFF","fillAlpha":0.1,"strokeWidth":8,"strokeColor":"#FFFFFF","strokeAlpha":1,"texture":null,"text":"When they're not watching a tournament in the arena (area X6) or listening to Xanathar give a speech in the audience chamber (area X18), ten human bandits are in area X9","fontFamily":"Signika","fontSize":24,"textColor":"#FFFFFF","textAlpha":1,"hidden":true,"locked":false,"flags":{"tagger":{},"perfect-vision":{"enabled":false,"fit":false,"prototype":null}},"_id":"wxFY3bEOrRAxnQdW"},{"author":"ZWZhNTMzZTE2NzI3","shape":{"type":"r","width":975,"height":125,"radius":null,"points":[]},"x":38,"y":2313,"z":0,"rotation":0,"bezierFactor":0,"fillType":0,"fillColor":"#FFFFFF","fillAlpha":0.1,"strokeWidth":8,"strokeColor":"#FFFFFF","strokeAlpha":1,"texture":null,"text":"If he is not with Xanathar in the arena (Area X6), Ahmaergo is conducting a routine inspection of the dungeon in X17. If he sees intruders and is outnumbered, Ahmaergo retreats to area X22, heads downstairs to gather reingorcements from area X28.","fontFamily":"Signika","fontSize":24,"textColor":"#FFFFFF","textAlpha":1,"hidden":true,"locked":false,"flags":{"tagger":{},"perfect-vision":{"enabled":false,"fit":false,"prototype":null}},"_id":"h7ORdWnlcFphya8M"}],"flags":{"ddb":{"bookCode":"wdh","ddbId":13057,"cobaltId":null,"parentId":560,"contentChunkId":"f9a869c9-cd1c-4b3f-8b3b-613624572508","foundryVersion":"10.291","versions":{"ddbMetaData":{"name":"Xanathar's Lair (Main Floor)","bookCode":"wdh","contentChunkId":"f9a869c9-cd1c-4b3f-8b3b-613624572508","lastUpdate":"1.1.29","notes":"1.1.29","tokens":"1.1.29","walls":"1.1.29","lights":"1.1.29","drawings":"1.1.29","regions":"1.1.29","foundry":"10.291"}},"noteInfos":[{"ddbId":57,"cobaltId":null,"parentId":560,"splitTag":"h4","slug