or":"#FFFFFF","strokeWidth":8,"text":"If it is Founder's Day, the black viper is hiding in an alcove putting on her mask and hood in C2","textAlpha":1,"textColor":"#FFFFFF","texture":null,"x":183.59489046638555,"y":6325.467090771486,"z":0},{"_id":"PbZIR61yqnuyhpGd","author":"ZWZhNTMzZTE2NzI3","bezierFactor":0,"fillAlpha":0.1,"fillColor":"#FFFFFF","fillType":0,"flags":{"perfect-vision":{"enabled":false,"fit":false,"prototype":null},"tagger":{}},"fontFamily":"Signika","fontSize":48,"hidden":false,"locked":false,"rotation":0,"shape":{"height":263,"points":[],"radius":null,"type":"r","width":1275},"strokeAlpha":1,"strokeColor":"#FFFFFF","strokeWidth":8,"text":"Lady Ammalia Cassalanter: Roll 1d100. 01-70, She's tending her butterfly garden in C25. 71-90, she's smoking on the balcony in C25a. 91-100 She's weeping before Osvaldo in the attic in area C24.","textAlpha":1,"textColor":"#FFFFFF","texture":null,"x":233.59489046638555,"y":525.4670907714863,"z":0},{"_id":"QYat4O5U7rNkPu3D","author":"ZWZhNTMzZTE2NzI3","bezierFactor":0,"fillAlpha":0.1,"fillColor":"#FFFFFF","fillType":0,"flags":{"perfect-vision":{"enabled":false,"fit":false,"prototype":null},"tagger":{}},"fontFamily":"Signika","fontSize":48,"hidden":false,"locked":false,"rotation":0,"shape":{"height":263,"points":[],"radius":null,"type":"r","width":1275},"strokeAlpha":1,"strokeColor":"#FFFFFF","strokeWidth":8,"text":"Lord Victoro Cassalanter: Roll 1d100. 01-70 He's in his office (area C6). 71-90 He's in the reading room (area C4). 91-100 he's with Ammalia at one of her three locations.","textAlpha":1,"textColor":"#FFFFFF","texture":null,"x":246.09489046638555,"y":950.4670907714863,"z":0},{"_id":"ilw4OqdMPZih3mde","author":"ZWZhNTMzZTE2NzI3","bezierFactor":0,"fillAlpha":0.1,"fillColor":"#FFFFFF","fillType":0,"flags":{"perfect-vision":{"enabled":false,"fit":false,"prototype":null},"tagger":{}},"fontFamily":"Signika","fontSize":48,"hidden":false,"locked":false,"rotation":0,"shape":{"height":263,"points":[],"radius":null,"type":"r","width":1275},"strokeAlpha":1,"strokeColor":"#FFFFFF","strokeWidth":8,"text":"Terenzio and Elzerina Cassalanter: Roll 1d100. 01-50, they're playing in their room (area C18). 51-75 They're in the library (C3). 76-100 They're chasing butterflies in the garden (area C25).","textAlpha":1,"textColor":"#FFFFFF","texture":null,"x":246.09489046638555,"y":1350.4670907714863,"z":0},{"_id":"4TjvPf3vskBAHBz8","author":"ZWZhNTMzZTE2NzI3","bezierFactor":0,"fillAlpha":0.1,"fillColor":"#FFFFFF","fillType":0,"flags":{"perfect-vision":{"enabled":false,"fit":false,"prototype":null},"tagger":{}},"fontFamily":"Signika","fontSize":48,"hidden":false,"locked":false,"rotation":0,"shape":{"height":225,"points":[],"radius":null,"type":"r","width":1275},"strokeAlpha":1,"strokeColor":"#FFFFFF","strokeWidth":8,"text":"The below three head servants are noted as cult fanatics but are in disguise as tiefling servants. Replace their tokens with the image of a tiefling.","textAlpha":1,"textColor":"#FFFFFF","texture":null,"x":233.59489046638555,"y":2325.4670907714863,"z":0},{"_id":"HZzyxAKPXMC0kAlY","author":"ZWZhNTMzZTE2NzI3","bezierFactor":0,"fillAlpha":0.1,"fillColor":"#FFFFFF","fillType":0,"flags":{"perfect-vision":{"enabled":false,"fit":false,"prototype":null},"tagger":{}},"fontFamily":"Signika","fontSize":48,"hidden":false,"locked":false,"rotation":0,"shape":{"height":175,"points":[],"radius":null,"type":"r","width":1287},"strokeAlpha":1,"strokeColor":"#FFFFFF","strokeWidth":8,"text":"On founders day several nobles and 100 of Waterdeep's poorest comoners gather on the lawn, ballroom, the entry, dining room and foyer","textAlpha":1,"textColor":"#FFFFFF","texture":null,"x":208.59489046638555,"y":6600.467090771486,"z":0},{"_id":"SHEeZlRatY3t3Jeh","author":"ZWZhNTMzZTE2NzI3","bezierFactor":0,"fillAlpha":0.1,"fillColor":"#FFFFFF","fillType":0,"flags":{"perfect-vision":{"enabled":false,"fit":false,"prototype":null},"tagger":{}},"fontFamily":"Signika","fontSize":48,"hidden":false,"locked":false,"rotation":0,"shape":{"height":413,"points":[],"radius":null,"type":"r","width":1302},"strokeAlpha":1,"strokeColor":"#FFFFFF","strokeWidth":8,"text":"Four doppelgangers from the Yawning Portal have slipped into the party disguised as nobles. Their leader, Bonnie (see “Familiar Faces” journal entry), poses as a minor noblewoman going by the name Lymeria Lhaurilstar; she was hoping to have a fun night at the party, but she’s willing to help the characters if they need aid.  NOTE: REMEMBER TO CHANGE THE TOKEN PICTURE TO A NOBLE.","textAlpha":1,"textColor":"#FFFFFF","texture":null,"x":208.59489046638555,"y":6912.967090771486,"z":0}],"flags":{"ddb":{"bookCode":"wdh","cobaltId":null,"contentChunkId":"ddb-missing-wdh-103093","ddbId":103093,"foundryVersion":"10.291","noteInfos":[{"cobaltId":null,"contentChunkIdStart":"003b7f15-fc01-42cc-a344-0c9a0b370e40","contentChunkIdStop":"EOF","ddbId":62,"parentId":561,"sceneName":"Cassalanter Villa","slug":"hell-of-a-summer#CassalanterVilla","splitTag":"h4","tagIdFirst":"C1EntranceHall","tagIdLast":""}],"parentId":561,"versions":{"ddbMetaData":{"bookCode":"wdh","contentChunkId":"ddb-missing-wdh-103093","drawings":"0.3.28","foundry":"10.291","lastUpdate":"0.3.28","lights":"0.3.28","name":"Cassalanter Villa (Villa Cellar)","notes":"0.3.28","tokens":"0.3.28","walls":"0.3.28"}}},"ddbimporter":{"version":"3.4.15"},"dynamic-illumination":{},"perfect-vision":{"darknessColor":"","daylightColor":"","fogRevealed":false},"stairways":[{"_id":"JDTOtpFfvWjel0VC","animate":false,"disabled":false,"fontFamily":"","fontSize":null,"height":null,"hidden":false,"icon":null,"label":"","name":"sw-Z1eTvDvb","partnerSceneLabel":false,"scene":"KcTIXmZEGHT0iFic","textColor":null,"width":null,"x":5350,"y":8350},{"_id":"xj6mJUIcPj9wBgcx","animate":false,"disabled":false,"fontFamily":"Arial","fontSize":null,"height":null,"hidden":false,"icon":null,"label":"Stairway farther down","name":"sw-E72RqPqm","partnerSceneLabel":false,"scene":"uvDSpsgyc3bK41wr","textCo