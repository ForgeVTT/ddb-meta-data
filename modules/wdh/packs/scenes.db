exture":null,"text":"These are here as potential audience members if there is an ongoing case in the courtroom.","fontFamily":"Signika","fontSize":48,"textColor":"#FFFFFF","textAlpha":1,"hidden":true,"locked":false,"flags":{"tagger":{},"perfect-vision":{"enabled":false,"fit":false,"prototype":null}}},{"_id":"5G1EB5JjumGOE37Y","author":"ZWZhNTMzZTE2NzI3","shape":{"type":"r","width":718,"height":425,"radius":null,"points":[]},"x":4500,"y":450,"z":0,"rotation":0,"bezierFactor":0,"fillType":0,"fillColor":"#FFFFFF","fillAlpha":0.1,"strokeWidth":8,"strokeColor":"#FFFFFF","strokeAlpha":1,"texture":null,"text":"The carriage requires 2 horses to move. Unless otherwise stated, the horses are not automatically present, however are placed to the side for your convenience.","fontFamily":"Signika","fontSize":48,"textColor":"#FFFFFF","textAlpha":1,"hidden":true,"locked":false,"flags":{"tagger":{},"perfect-vision":{"enabled":false,"fit":false,"prototype":null}}},{"author":"ZWZhNTMzZTE2NzI3","shape":{"type":"r","width":718,"height":425,"radius":null,"points":[]},"x":4500,"y":1162.5,"z":0,"rotation":0,"bezierFactor":0,"fillType":0,"fillColor":"#FFFFFF","fillAlpha":0.1,"strokeWidth":8,"strokeColor":"#FFFFFF","strokeAlpha":1,"texture":null,"text":"If Willifort Crowell is still alive, he arrives in the disguise of Guard captain Hyustus Staget. See notes for the summer encounter.","fontFamily":"Signika","fontSize":48,"textColor":"#FFFFFF","textAlpha":1,"hidden":true,"locked":false,"flags":{"tagger":{},"perfect-vision":{"enabled":false,"fit":false,"prototype":null}},"_id":"5EIvJm2crWQtx6kk"},{"author":"ZWZhNTMzZTE2NzI3","shape":{"type":"r","width":878,"height":250,"radius":null,"points":[]},"x":1900,"y":400,"z":0,"rotation":0,"bezierFactor":0,"fillType":0,"fillColor":"#FFFFFF","fillAlpha":0.1,"strokeWidth":8,"strokeColor":"#FFFFFF","strokeAlpha":1,"texture":null,"text":"When court is in session, the magister and his guard are in the courtroom. When not, he is in his office.","fontFamily":