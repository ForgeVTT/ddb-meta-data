,"points":[]},"x":5275,"y":8350,"z":0,"rotation":135,"bezierFactor":0,"fillType":0,"fillColor":"#FFFFFF","fillAlpha":0.1,"strokeWidth":8,"strokeColor":"#FFFFFF","strokeAlpha":0,"texture":null,"text":"⬆︎","fontFamily":"Signika","fontSize":48,"textColor":"#FFFFFF","textAlpha":1,"hidden":false,"locked":false,"flags":{"tagger":{}},"_id":"9SlBmO4nT6sjGLP5"},{"author":"ZWZhNTMzZTE2NzI3","shape":{"type":"r","width":45,"height":75,"radius":null,"points":[]},"x":5875,"y":9062.5,"z":0,"rotation":0,"bezierFactor":0,"fillType":0,"fillColor":"#FFFFFF","fillAlpha":0.1,"strokeWidth":8,"strokeColor":"#FFFFFF","strokeAlpha":0,"texture":null,"text":"⬆︎","fontFamily":"Signika","fontSize":48,"textColor":"#FFFFFF","textAlpha":1,"hidden":false,"locked":false,"flags":{"tagger":{}},"_id":"G8XJ7X4ueL6pKFvY"},{"_id":"PTny35OEqveccu1N","author":"ZWZhNTMzZTE2NzI3","shape":{"type":"r","width":1275,"height":120,"radius":null,"points":[]},"x":162.5,"y":6337.5,"z":0,"rotation":0,"bezierFactor":0,"fillType":0,"fillColor":"#FFFFFF","fillAlpha":0.1,"strokeWidth":8,"strokeColor":"#FFFFFF","strokeAlpha":1,"texture":null,"text":"If it is Founder's Day, the black viper is hiding in an alcove putting on her mask and hood in C2","fontFamily":"Signika","fontSize":48,"textColor":"#FFFFFF","textAlpha":1,"hidden":false,"locked":false,"flags":{"tagger":{},"perfect-vision":{"enabled":false,"fit":false,"prototype":null}}},{"author":"ZWZhNTMzZTE2NzI3","shape":{"type":"r","width":1275,"height":263,"radius":null,"points":[]},"x":212.5,"y":537.5,"z":0,"rotation":0,"bezierFactor":0,"fillType":0,"fillColor":"#FFFFFF","fillAlpha":0.1,"strokeWidth":8,"strokeColor":"#FFFFFF","strokeAlpha":1,"texture":null,"text":"Lady Ammalia Cassalanter: Roll 1d100. 01-70, She's tending her butterfly garden in C25. 71-90, she's smoking on the balcony in C25a. 91-100 She's weeping before Osvaldo in the attic in area C24.","fontFamily":"Signika","fontSize":48,"textColor":"#FFFFFF","textAlpha":1,"hidden":false,"locked":false,"flags":{"tagger":{},"perfect-vision":{"enabled":false,"fit":false,"prototype":null}},"_id":"wwzu47UbzjWgZCNy"},{"author":"ZWZhNTMzZTE2NzI3","shape":{"type":"r","width":1275,"height":263,"radius":null,"points":[]},"x":225,"y":962.5,"z":0,"rotation":0,"bezierFactor":0,"fillType":0,"fillColor":"#FFFFFF","fillAlpha":0.1,"strokeWidth":8,"strokeColor":"#FFFFFF","strokeAlpha":1,"texture":null,"text":"Lord Victoro Cassalanter: Roll 1d100. 01-70 He's in his office (area C6). 71-90 He's in the reading room (area C4). 91-100 he's with Ammalia at one of her three locations.","fontFamily":"Signika","fontSize":48,"textColor":"#FFFFFF","textAlpha":1,"hidden":false,"locked":false,"flags":{"tagger":{},"perfect-vision":{"enabled":false,"fit":false,"prototype":null}},"_id":"PTvbvlQI4ZcP4a5F"},{"author":"ZWZhNTMzZTE2NzI3","shape":{"type":"r","width":1275,"height":263,"radius":null,"points":[]},"x":225,"y":1362.5,"z":0,"rotation":0,"bezierFactor":0,"fillType":0,"fillColor":"#FFFFFF","fillAlpha":0.1,"strokeWidth":8,"strokeColor":"#FFFFFF","strokeAlpha":1,"texture":null,"text":"Terenzio and Elzerina Cassalanter: Roll 1d100. 01-50, they're playing in their room (area C18). 51-75 They're in the library (C3). 76-100 They're chasing butterflies in the garden (area C25).","fontFamily":"Signika","fontSize":48,"textColor":"#FFFFFF","textAlpha":1,"hidden":false,"locked":false,"flags":{"tagger":{},"perfect-vision":{"enabled":false,"fit":false,"prototype":null}},"_id":"Fy5XVmkdeBUhjIk4"},{"author":"ZWZhNTMzZTE2NzI3","shape":{"type":"r","width":1275,"height":225,"radius":null,"points":[]},"x":213,"y":2338,"z":0,"rotation":0,"bezierFactor":0,"fillType":0,"fillColor":"#FFFFFF","fillAlpha":0.1,"strokeWidth":8,"strokeColor":"#FFFFFF","strokeAlpha":1,"texture":null,"text":"The below three head servants are noted as cult fanatics but are in disguise as tiefling servants. Replace their tokens with the image of a tiefling.","fontFamily":"Signika","fontSize":48,"textColor":"#FFFFFF","textAlpha":1,"hidden":false,"locked":false,"flags":{"tagger":{},"perfect-vision":{"enabled":false,"fit":false,"prototype":null}},"_id":"EL7rRydtgTj5cANr"},{"author":"ZWZhNTMzZTE2NzI3","shape":{"type":"r","width":1287,"height":175,"radius":null,"points":[]},"x":188,"y":6613,"z":0,"rotation":0,"bezierFactor":0,"fillType":0,"fillColor":"#FFFFFF","fillAlpha":0.1,"strokeWidth":8,"strokeColor":"#FFFFFF","strokeAlpha":1,"texture":null,"text":"On founders day several nobles and 100 of Waterdeep's poorest comoners gather on the lawn, ballroom, the entry, dining room and foyer","fontFamily":"Signika","fontSize":48,"textColor":"#FFFFFF","textAlpha":1,"hidden":false,"locked":false,"flags":{"tagger":{},"perfect-vision":{"enabled":false,"fit":false,"prototype":null}},"_id":"2IWL3CPTeEXQKup5"},{"author":"ZWZhNTMzZTE2NzI3","shape":{"type":"r","width":1302,"height":413,"radius":null,"points":[]},"x":188,"y":6925,"z":0,"rotation":0,"bezierFactor":0,"fillType":0,"fillColor":"#FFFFFF","fillAlpha":0.1,"strokeWidth":8,"strokeColor":"#FFFFFF","strokeAlpha":1,"texture":null,"text":"Four doppelgangers from the Yawning Portal have slipped into the party disguised as nobles. Their leader, Bonnie (see “Familiar Faces” journal entry), poses as a minor noblewoman going by the name Lymeria Lhaurilstar; she was hoping to have a fun night at the party, but she’s willing to help the characters if they need aid.  NOTE: REMEMBER TO CHANGE THE TOKEN PICTURE TO A NOBLE.","fontFamily":"Signika","fontSize":48,"textColor":"#FFFFFF","textAlpha":1,"hidden":false,"locked":false,"flags":{"tagger":{},"perfect-vision":{"enabled":false,"fit":false,"prototype":null}},"_id":"ZMzKAskYyuvVzCIw"}],"flags":{"ddb":{"bookCode":"wdh","ddbId":103090,"cobaltId":null,"parentId":561,"contentChunkId":"ddb-missing-wdh-103090","foundryVersion":"10.291","versions":{"ddbMetaData":{"name":"Cassalanter Villa (Guest 2nd Floor)","bookCode":"wdh","contentChunkId":"ddb-missing-wdh-103090","lastUpdate":"0.3.28","notes":"0.3.28","tokens":"0.3.28","walls":"0.3.28","lights":"0.